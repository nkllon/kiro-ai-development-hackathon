# Redis Configuration Environment Variables
# Copy this file to .env or add to your existing .env file
#
# NOTE: Using port 6380 to avoid conflict with existing Redis cluster on 6379

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=beastmode2025
REDIS_DB=0

# Redis Connection Pool
REDIS_MAX_CONNECTIONS=10
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=2

# Redis URL (alternative to individual params)
REDIS_URL=redis://:beastmode2025@localhost:6380/0

# Data paths
REDIS_DATA_PATH=./data/redis

# Optional: Redis Commander (Web UI)
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_PASSWORD=admin

# Optional: Redis Exporter (Prometheus)
REDIS_EXPORTER_PORT=9121

# Application-specific
OBSERVATORY_STREAM_NAME=observatory_metrics
OBSERVATORY_CONSUMER_GROUP=observatory_group
BEAST_MODE_REDIS_ENABLED=true

