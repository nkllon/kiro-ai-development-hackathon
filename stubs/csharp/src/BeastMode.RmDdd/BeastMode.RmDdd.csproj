<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>BeastMode.RmDdd</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>RM-DDD C# Stubs</Title>
    <Description>C# interfaces and stubs for RM-DDD framework following .NET conventions</Description>
    <Authors>Beast Mode Team</Authors>
    <Company>Beast Mode</Company>
    <PackageProjectUrl>https://github.com/beastmode/rm-ddd</PackageProjectUrl>
    <RepositoryUrl>https://github.com/beastmode/rm-ddd</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ddd;domain-driven-design;csharp;dotnet;systematic;beast-mode</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>