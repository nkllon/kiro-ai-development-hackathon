# Service Auto-Start Governance Makefile
# Generated by ServiceRegistrar on 2025-10-04T06:03:30.114895
# 
# This Makefile provides targets for managing service auto-start configuration
# across multiple platforms (macOS, Linux, Docker).

.PHONY: help install-all verify-all remove-all status-all
.DEFAULT_GOAL := help

# Platform detection
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
    PLATFORM := macos
endif
ifeq ($(UNAME_S),Linux)
    PLATFORM := linux
endif

# Service configuration
DIRECTUS_PORT := 8055
OBSERVATORY_PORT := 8888
PROMETHEUS_PORT := 9090
GRAFANA_PORT := 3000


# MACOS Platform Targets
install-macos: install-directus-macos install-observatory-macos install-monitoring-macos
	@echo "✅ All services installed for macos"

verify-macos: verify-directus-macos verify-observatory-macos verify-monitoring-macos
	@echo "✅ All services verified for macos"

remove-macos: remove-directus-macos remove-observatory-macos remove-monitoring-macos
	@echo "✅ All services removed for macos"

status-macos: status-directus-macos status-observatory-macos status-monitoring-macos
	@echo "📊 Status check complete for macos"


# LINUX Platform Targets
install-linux: install-directus-linux install-observatory-linux install-monitoring-linux
	@echo "✅ All services installed for linux"

verify-linux: verify-directus-linux verify-observatory-linux verify-monitoring-linux
	@echo "✅ All services verified for linux"

remove-linux: remove-directus-linux remove-observatory-linux remove-monitoring-linux
	@echo "✅ All services removed for linux"

status-linux: status-directus-linux status-observatory-linux status-monitoring-linux
	@echo "📊 Status check complete for linux"


# DOCKER Platform Targets
install-docker: install-directus-docker install-observatory-docker install-monitoring-docker
	@echo "✅ All services installed for docker"

verify-docker: verify-directus-docker verify-observatory-docker verify-monitoring-docker
	@echo "✅ All services verified for docker"

remove-docker: remove-directus-docker remove-observatory-docker remove-monitoring-docker
	@echo "✅ All services removed for docker"

status-docker: status-directus-docker status-observatory-docker status-monitoring-docker
	@echo "📊 Status check complete for docker"


# DIRECTUS Service Targets

install-directus-macos:
	@echo "🚀 Installing directus for macos..."
	@python -c "from src.service_auto_start.cli import install_service; install_service('directus', 'macos')"

verify-directus-macos:
	@echo "🔍 Verifying directus for macos..."
	@python -c "from src.service_auto_start.cli import verify_service; verify_service('directus', 'macos')"

remove-directus-macos:
	@echo "🗑️  Removing directus for macos..."
	@python -c "from src.service_auto_start.cli import remove_service; remove_service('directus', 'macos')"

status-directus-macos:
	@echo "📊 Checking directus status for macos..."
	@python -c "from src.service_auto_start.cli import service_status; service_status('directus', 'macos')"

install-directus-linux:
	@echo "🚀 Installing directus for linux..."
	@python -c "from src.service_auto_start.cli import install_service; install_service('directus', 'linux')"

verify-directus-linux:
	@echo "🔍 Verifying directus for linux..."
	@python -c "from src.service_auto_start.cli import verify_service; verify_service('directus', 'linux')"

remove-directus-linux:
	@echo "🗑️  Removing directus for linux..."
	@python -c "from src.service_auto_start.cli import remove_service; remove_service('directus', 'linux')"

status-directus-linux:
	@echo "📊 Checking directus status for linux..."
	@python -c "from src.service_auto_start.cli import service_status; service_status('directus', 'linux')"

install-directus-docker:
	@echo "🚀 Installing directus for docker..."
	@python -c "from src.service_auto_start.cli import install_service; install_service('directus', 'docker')"

verify-directus-docker:
	@echo "🔍 Verifying directus for docker..."
	@python -c "from src.service_auto_start.cli import verify_service; verify_service('directus', 'docker')"

remove-directus-docker:
	@echo "🗑️  Removing directus for docker..."
	@python -c "from src.service_auto_start.cli import remove_service; remove_service('directus', 'docker')"

status-directus-docker:
	@echo "📊 Checking directus status for docker..."
	@python -c "from src.service_auto_start.cli import service_status; service_status('directus', 'docker')"

install-directus: install-directus-$(PLATFORM)
verify-directus: verify-directus-$(PLATFORM)
remove-directus: remove-directus-$(PLATFORM)
status-directus: status-directus-$(PLATFORM)


