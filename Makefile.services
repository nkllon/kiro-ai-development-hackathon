# Utility Targets
help:
	@echo "Service Auto-Start Governance Makefile"
	@echo ""
	@echo "Platform-specific targets:"
	@echo "  install-macos     Install all services for macOS"
	@echo "  install-linux     Install all services for Linux"
	@echo "  install-docker    Install all services for Docker"
	@echo ""
	@echo "Service-specific targets:"
	@echo "  install-directus     Install Directus CMS"
	@echo "  install-observatory  Install Observatory WebSocket system"
	@echo "  install-monitoring   Install monitoring stack"
	@echo ""
	@echo "Management targets:"
	@echo "  verify-all        Verify all services"
	@echo "  status-all        Check status of all services"
	@echo "  remove-all        Remove all service configurations"
	@echo "  health-check      Run comprehensive health check"
	@echo ""
	@echo "Current platform: $(PLATFORM)"

install-all: install-$(PLATFORM)
verify-all: verify-$(PLATFORM)
remove-all: remove-$(PLATFORM)
status-all: status-$(PLATFORM)

health-check:
	@echo "🏥 Running comprehensive health check..."
	@python -c "from src.service_auto_start.cli import health_check; health_check()"

list-services:
	@echo "📋 Listing registered services..."
	@python -c "from src.service_auto_start.cli import list_services; list_services()"

validate-config:
	@echo "✅ Validating service configurations..."
	@python -c "from src.service_auto_start.cli import validate_config; validate_config()"

startup-order:
	@echo "🔄 Calculating service startup order..."
	@python -c "from src.service_auto_start.cli import show_startup_order; show_startup_order()"

# Development targets
test-services:
	@echo "🧪 Running service tests..."
	@pytest tests/unit/service_auto_start/ -v

lint-services:
	@echo "🔍 Linting service code..."
	@flake8 src/service_auto_start/

# Emergency targets
emergency-stop:
	@echo "🚨 Emergency stop all services..."
	@python -c "from src.service_auto_start.cli import emergency_stop; emergency_stop()"

emergency-restart:
	@echo "🔄 Emergency restart all services..."
	@python -c "from src.service_auto_start.cli import emergency_restart; emergency_restart()"

# Monitoring targets
dashboard:
	@echo "📊 Opening monitoring dashboard..."
	@open http://localhost:$(GRAFANA_PORT) || xdg-open http://localhost:$(GRAFANA_PORT)

prometheus:
	@echo "📈 Opening Prometheus..."
	@open http://localhost:$(PROMETHEUS_PORT) || xdg-open http://localhost:$(PROMETHEUS_PORT)

directus-admin:
	@echo "🎛️  Opening Directus admin..."
	@open http://localhost:$(DIRECTUS_PORT)/admin || xdg-open http://localhost:$(DIRECTUS_PORT)/admin

observatory-ws:
	@echo "🔭 Opening Observatory WebSocket..."
	@open http://localhost:$(OBSERVATORY_PORT) || xdg-open http://localhost:$(OBSERVATORY_PORT)

