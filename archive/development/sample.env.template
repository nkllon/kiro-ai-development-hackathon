# Sample environment variables for DAG coordination
# Copy this to ~/.env and update with your actual values

# Redis Configuration
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
BEAST_MODE_REDIS_PASSWORD=YOUR_BEAST_MODE_REDIS_PASSWORD_HERE

# Alternative Redis settings (if needed)
REDIS_HOST=YOUR_REDIS_HOST_HERE
REDIS_PORT=YOUR_REDIS_PORT_HERE

# Environment identification
DEVELOPMENT=YOUR_DEVELOPMENT_HERE
# PRODUCTION=true  # Uncomment for production

# Directus CMS Configuration
DIRECTUS_ADMIN_PASSWORD=YOUR_DIRECTUS_ADMIN_PASSWORD_HERE
DIRECTUS_URL=YOUR_DIRECTUS_URL_HERE
DIRECTUS_ADMIN_EMAIL=YOUR_DIRECTUS_ADMIN_EMAIL_HERE

# Grafana Configuration
GF_SECURITY_ADMIN_PASSWORD=YOUR_GF_SECURITY_ADMIN_PASSWORD_HERE

# Other Beast Mode settings
BEAST_MODE_ENV=YOUR_BEAST_MODE_ENV_HERE