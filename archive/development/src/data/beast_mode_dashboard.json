{
  "dashboard": {
    "id": null,
    "title": "Beast Mode Performance Observatory",
    "tags": ["beast-mode", "performance", "ai-coordination"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Development Velocity Improvement",
        "type": "stat",
        "targets": [
          {
            "expr": "beast_mode_features_completed_per_day",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1.5},
                {"color": "green", "value": 2.0}
              ]
            },
            "unit": "features/day"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Code Quality Score",
        "type": "gauge",
        "targets": [
          {
            "expr": "beast_mode_code_quality_score",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 10,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 6},
                {"color": "green", "value": 8}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Bug Resolution Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "beast_mode_bugs_fixed_per_day",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 2},
                {"color": "green", "value": 3}
              ]
            },
            "unit": "bugs/day"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Time to Resolution",
        "type": "stat",
        "targets": [
          {
            "expr": "beast_mode_time_to_resolution_hours",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 6},
                {"color": "red", "value": 10}
              ]
            },
            "unit": "hours"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "Performance Trends Over Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "beast_mode_features_completed_per_day",
            "refId": "A",
            "legendFormat": "Features/Day"
          },
          {
            "expr": "beast_mode_bugs_fixed_per_day",
            "refId": "B",
            "legendFormat": "Bugs Fixed/Day"
          },
          {
            "expr": "beast_mode_code_quality_score",
            "refId": "C",
            "legendFormat": "Code Quality Score"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "pointSize": 5
            }
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "Rework Percentage Reduction",
        "type": "bargauge",
        "targets": [
          {
            "expr": "beast_mode_rework_percentage",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 20},
                {"color": "red", "value": 30}
              ]
            },
            "unit": "percent",
            "max": 50
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 7,
        "title": "System Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"beast-mode-metrics\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "DOWN"}}, "type": "value"},
              {"options": {"1": {"text": "UP"}}, "type": "value"}
            ]
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 8,
        "title": "WebSocket Connection Status",
        "type": "timeseries",
        "targets": [
          {
            "expr": "websocket_connections_total",
            "refId": "A",
            "legendFormat": "Active Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "pointSize": 3
            },
            "unit": "connections"
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "5s"
  },
  "overwrite": true
}