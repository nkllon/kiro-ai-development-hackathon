{
  "mcpServers": {
    "filesystem": {
      "command": "uvx",
      "args": [
        "mcp-server-filesystem",
        "--path",
        "."
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "read_file",
        "list_directory"
      ],
      "disabledTools": []
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "git_log",
        "git_diff",
        "git_status",
        "git_add",
        "git_commit"
      ],
      "disabledTools": []
    }
  }
}