# Directus CMS Environment Configuration
# This file contains environment variables for the Directus CMS setup
# Copy to .env and modify values for your environment

# Database Configuration
DATABASE_URL=postgresql://directus:directus@localhost:5432/directus
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=directus

# Directus Configuration
KEY=directus-key-change-in-production-$(openssl rand -hex 16)
SECRET=directus-secret-change-in-production-$(openssl rand -hex 32)

# Admin User
ADMIN_EMAIL=admin@directus.local
ADMIN_PASSWORD=directus

# Security
CORS_ENABLED=true
CORS_ORIGIN=true
PUBLIC_URL=http://localhost:8055

# Storage
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# Cache and Performance
CACHE_ENABLED=true
CACHE_STORE=redis
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379

# Rate Limiting
RATE_LIMITER_ENABLED=true
RATE_LIMITER_STORE=redis
RATE_LIMITER_REDIS_HOST=redis
RATE_LIMITER_REDIS_PORT=6379
RATE_LIMITER_POINTS=25
RATE_LIMITER_DURATION=1

# WebSockets
WEBSOCKETS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_STYLE=pretty

# Email (for production)
EMAIL_FROM=no-reply@directus.local
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587

# Beast Mode Integration
BEAST_MODE_PROMETHEUS_ENABLED=true
BEAST_MODE_PROMETHEUS_PORT=8000

# Repository Content Schema
REPOSITORY_SCHEMA=repository_content