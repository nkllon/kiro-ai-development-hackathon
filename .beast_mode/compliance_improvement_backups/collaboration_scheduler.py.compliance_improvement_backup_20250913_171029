        relevant_patterns = [pattern for pattern in self.collaboration_patterns.values() if agent_id in pattern.participants and pattern.confidence_score > 0.5]
        for pattern in relevant_patterns:
            other_participants = [p for p in pattern.participants if p != agent_id]
            optimal_time = None
