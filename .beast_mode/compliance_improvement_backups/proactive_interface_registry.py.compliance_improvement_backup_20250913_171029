        """Evaluate if interface can be registered"""
        # Block if exact duplicate
        if duplication_check.is_duplicate:
            print(f"❌ Blocked: Exact duplicate detected")
            return False
        
        # Block if very high similarity
        very_high_similarities = [
            sim for sim in duplication_check.similar_interfaces 
            if sim.similarity_score >= 0.9
        ]
        if very_high_similarities:
            print(f"❌ Blocked: Very high similarity with {len(very_high_similarities)} interfaces")
            return False
        
        # Block if critical conflicts
        critical_conflicts = [
            conflict for conflict in duplication_check.conflicts
            if 'exact duplicate' in conflict.lower() or 'very high similarity' in conflict.lower()
        ]
        if critical_conflicts:
            print(f"❌ Blocked: Critical conflicts detected")
            return False
        
        # Allow with warnings for moderate similarities
        return True
    
