            if analysis.is_ambiguous:
                results["summary"]["interfaces_ambiguous"] += 1
            if analysis.consolidation_needed:
                results["summary"]["interfaces_needing_consolidation"] += 1
        
        # Display results
        self._display_accurate_results(results)
        
        return results
    
