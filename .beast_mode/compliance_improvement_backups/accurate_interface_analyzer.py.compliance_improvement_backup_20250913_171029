#!/usr/bin/env python3
"""
Accurate Interface Analyzer - Find actual interface definitions, not text matches

This tool addresses the false positive issue where the requirements analysis
finds 45+ "requirements" that are actually just text matches, not real
interface specifications.

The approach: Find actual interface definitions and trace real dependencies.
"""

import json
import ast
from pathlib import Path
from typing import Dict, List, Set, Tuple, Optional
from dataclasses import dataclass, field
from collections import defaultdict, Counter
import re
from datetime import datetime


@dataclass
class ActualInterfaceDefinition:
    """Represents an actual interface definition found in the codebase"""
    interface_name: str
    file_path: str
    line_number: int
    class_type: str  # 'class', 'interface', 'protocol', 'abc', 'exception'
    methods: List[str] = field(default_factory=list)
    properties: List[str] = field(default_factory=list)
    base_classes: List[str] = field(default_factory=list)
    is_abstract: bool = False
    content: str = ""


@dataclass
class InterfaceReference:
    """Represents a reference to an interface (import, usage, etc.)"""
    interface_name: str
    file_path: str
    line_number: int
    reference_type: str  # 'import', 'usage', 'comment', 'docstring'
    context: str = ""


@dataclass
class InterfaceAnalysis:
    """Complete analysis of an interface"""
    interface_name: str
    actual_definitions: List[ActualInterfaceDefinition]
    references: List[InterfaceReference]
    is_defined: bool
    is_ambiguous: bool
    consolidation_needed: bool
    suggested_authoritative_file: str = ""


class AccurateInterfaceAnalyzer:
    """Analyzes interfaces accurately by finding actual definitions, not text matches"""
    
    def __init__(self, codebase_path -> Any: str = "src") -> Any:
        # Always use the project root's src directory
        # Find the project root by looking for the Makefile
        current_path = Path.cwd()
        while current_path != current_path.parent:
            if (current_path / "Makefile").exists():
                self.codebase_path = current_path / "src"
                break
            current_path = current_path.parent
        else:
            # Fallback to relative path
            self.codebase_path = Path(codebase_path)
        
        print(f"🔍 Analyzer initialized with codebase_path: {self.codebase_path}")
        print(f"🔍 Path exists: {self.codebase_path.exists()}")
        self.interface_analyses: Dict[str, InterfaceAnalysis] = {}
        self.target_interfaces = ["HubrisPattern", "Snapshot", "Entity", "AggregateRoot"]
    
    def analyze_interface(self, interface_name: str) -> InterfaceAnalysis:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Analyze a specific interface accurately"""
        print(f"🔍 Analyzing interface: {interface_name}")
        
        # Find actual interface definitions
        actual_definitions = self._find_actual_definitions(interface_name)
        
        # Find references to the interface
        references = self._find_interface_references(interface_name)
        
        # Analyze the results
        is_defined = len(actual_definitions) > 0
        is_ambiguous = len(actual_definitions) > 1
        consolidation_needed = len(actual_definitions) > 1 or len(references) > 10
        
        # Suggest authoritative file
        suggested_authoritative_file = self._suggest_authoritative_file(actual_definitions)
        
        analysis = InterfaceAnalysis(
            interface_name=interface_name,
            actual_definitions=actual_definitions,
            references=references,
            is_defined=is_defined,
            is_ambiguous=is_ambiguous,
            consolidation_needed=consolidation_needed,
            suggested_authoritative_file=suggested_authoritative_file
        )
        
        self.interface_analyses[interface_name] = analysis
        return analysis
    
    def _find_actual_definitions(self, interface_name: str) -> List[ActualInterfaceDefinition]:
        """Find actual interface definitions (not text matches)"""
        definitions = []
        print(f"    🔍 Searching in: {self.codebase_path}")
        print(f"    🔍 Path exists: {self.codebase_path.exists()}")
        
        for py_file in self.codebase_path.rglob("*.py"):
            try:
                with open(py_file, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                tree = ast.parse(content)
                file_definitions = self._extract_interface_definitions(py_file, content, tree, interface_name)
                if file_definitions:
                    print(f"    ✅ Found {len(file_definitions)} definitions in {py_file}")
                definitions.extend(file_definitions)
                
            except Exception as e:
                print(f"⚠️  Error parsing {py_file}: {e}")
                continue
        
        return definitions
    
    def _extract_interface_definitions(self, file_path: Path, content: str, tree: ast.AST, interface_name: str) -> List[ActualInterfaceDefinition]:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Extract actual interface definitions from a Python file"""
        definitions = []
        lines = content.split('\n')
        
        for node in ast.walk(tree):
            if isinstance(node, ast.ClassDef) and node.name == interface_name:
                # This is an actual class definition with the exact name
                definition = ActualInterfaceDefinition(
                    interface_name=interface_name,
                    file_path=str(file_path),
                    line_number=node.lineno,
                    class_type=self._classify_class_type(node),
                    methods=self._extract_methods(node),
                    properties=self._extract_properties(node),
                    base_classes=self._extract_base_classes(node),
                    is_abstract=self._is_abstract_class(node),
                    content=lines[node.lineno - 1].strip()
                )
                definitions.append(definition)
        
        return definitions
    
    def _classify_class_type(self, node: ast.ClassDef) -> str:
        """Classify the type of class"""
        if any('Protocol' in str(base) for base in node.bases):
            return 'protocol'
        elif any('ABC' in str(base) for base in node.bases):
            return 'abc'
        elif 'interface' in node.name.lower():
            return 'interface'
        elif 'error' in node.name.lower() or 'exception' in node.name.lower():
            return 'exception'
        else:
            return 'class'
    
    def _extract_methods(self, node: ast.ClassDef) -> List[str]:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Extract method names from a class"""
        methods = []
        for item in node.body:
            if isinstance(item, ast.FunctionDef):
                methods.append(item.name)
        return methods
    
    def _extract_properties(self, node: ast.ClassDef) -> List[str]:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Extract property names from a class"""
        properties = []
        for item in node.body:
            if isinstance(item, ast.FunctionDef):
                for decorator in item.decorator_list:
                    if isinstance(decorator, ast.Name) and decorator.id == 'property':
                        properties.append(item.name)
        return properties
    
    def _extract_base_classes(self, node: ast.ClassDef) -> List[str]:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Extract base class names"""
        base_classes = []
        for base in node.bases:
            if isinstance(base, ast.Name):
                base_classes.append(base.id)
        return base_classes
    
    def _is_abstract_class(self, node: ast.ClassDef) -> bool:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Check if class is abstract"""
        for item in node.body:
            if isinstance(item, ast.FunctionDef):
                for decorator in item.decorator_list:
                    if isinstance(decorator, ast.Name) and decorator.id == 'abstractmethod':
                        return True
        return False
    
    def _find_interface_references(self, interface_name: str) -> List[InterfaceReference]:
        """Find references to an interface (imports, usage, etc.)"""
        references = []
        
        for py_file in self.codebase_path.rglob("*.py"):
            try:
                with open(py_file, 'r', encoding='utf-8') as f:
                    content = f.read()
                
                lines = content.split('\n')
                file_references = self._extract_interface_references(py_file, lines, interface_name)
                references.extend(file_references)
                
            except Exception as e:
                print(f"⚠️  Error parsing {py_file}: {e}")
                continue
        
        return references
    
    def _extract_interface_references(self, file_path: Path, lines: List[str], interface_name: str) -> List[InterfaceReference]:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Extract references to an interface from a file"""
        references = []
        
        for i, line in enumerate(lines, 1):
            # Check for imports
            if f"import {interface_name}" in line or f"from.*import.*{interface_name}" in line:
                references.append(InterfaceReference(
                    interface_name=interface_name,
                    file_path=str(file_path),
                    line_number=i,
                    reference_type="import",
                    context=line.strip()
                ))
            
            # Check for usage in code
            elif interface_name in line and not line.strip().startswith('#'):
                references.append(InterfaceReference(
                    interface_name=interface_name,
                    file_path=str(file_path),
                    line_number=i,
                    reference_type="usage",
                    context=line.strip()
                ))
            
            # Check for comments/docstrings
            elif interface_name in line and line.strip().startswith('#'):
                references.append(InterfaceReference(
                    interface_name=interface_name,
                    file_path=str(file_path),
                    line_number=i,
                    reference_type="comment",
                    context=line.strip()
                ))
        
        return references
    
    def _suggest_authoritative_file(self, definitions: List[ActualInterfaceDefinition]) -> str:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Suggest the most authoritative file for an interface"""
        if not definitions:
            return ""
        
        # Score each definition
        scored_definitions = []
        for definition in definitions:
            score = 0
            
            # Prefer files in core/domain directories
            if 'core' in definition.file_path or 'domain' in definition.file_path:
                score += 20
            
            # Prefer files with more methods
            score += len(definition.methods) * 2
            
            # Prefer files with more properties
            score += len(definition.properties) * 3
            
            # Prefer abstract classes
            if definition.is_abstract:
                score += 10
            
            # Prefer files with 'interface' in the name
            if 'interface' in definition.file_path.lower():
                score += 5
            
            scored_definitions.append((score, definition))
        
        # Return the highest scoring file
        scored_definitions.sort(key=lambda x: x[0], reverse=True)
        return scored_definitions[0][1].file_path if scored_definitions else ""
    
    def run_accurate_analysis(self) -> Dict:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Run accurate analysis for target interfaces"""
        print("🚀 Starting Accurate Interface Analysis")
        print("=" * 60)
        
        results = {
