def _scan_competitors(self) -> List[CompetitorAnnouncement]:
    """Scan competitor sources for new announcements."""
    new_announcements = []
    for source_url in self.config.sources:
        try:
            announcements = self._scan_source(source_url)
            new_announcements.extend(announcements)
        except Exception as e:
            logger.error(f'Failed to scan source {source_url}: {e}')
    self.announcements.extend(new_announcements)
    self.announcements.sort(key=lambda x: x.published_at, reverse=True)
    self.announcements = self.announcements[:1000]
    return new_announcements

def _scan_source(self, source_url: str) -> List[CompetitorAnnouncement]:
    """Scan a specific source for announcements."""
    announcements = []
    try:
        headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'}
        response = requests.get(source_url, headers=headers, timeout=30)
        response.raise_for_status()
        soup = BeautifulSoup(response.content, 'html.parser')
        competitor = self._extract_competitor_from_url(source_url)
        links = soup.find_all('a', href=True)
        for link in links[:10]:
            title = link.get_text(strip=True)
            href = link.get('href', '')
            if title and len(title) > 10:
                matched_keywords = self._match_keywords(title)
                if matched_keywords:
                    announcement = CompetitorAnnouncement(competitor=competitor, title=title, content=title, url=href if href.startswith('http') else f"{source_url.rstrip('/')}/{href.lstrip('/')}", published_at=datetime.now(), threat_level=self._calculate_threat_level(title, matched_keywords), keywords_matched=matched_keywords, impact_score=self._calculate_impact_score(title, matched_keywords))
                    announcements.append(announcement)
    except Exception as e:
        logger.error(f'Error scanning source {source_url}: {e}')
    return announcements

