def __init__(self, config: Optional[MonitoringConfig]=None):
    """Initialize the real-time monitor."""
    self.config = config or MonitoringConfig()
    self.monitoring_active = False
    self.last_check = None
    self.announcements: List[CompetitorAnnouncement] = []
    self.alert_callbacks: List[Callable] = []
    self.data_dir = Path('data/competitive_monitoring')
    self.data_dir.mkdir(parents=True, exist_ok=True)
    logger.info('Real-time competitive monitor initialized')

def start_monitoring(self) -> Dict[str, Any]:
    """Start real-time competitive monitoring."""
    logger.info('Starting real-time competitive monitoring')
    try:
        self.monitoring_active = True
        self.last_check = datetime.now()
        initial_results = self._scan_competitors()
        asyncio.create_task(self._periodic_monitoring())
        result = {'monitoring_active': True, 'competitors_monitored': len(self.config.competitors), 'sources_monitored': len(self.config.sources), 'initial_announcements': len(initial_results), 'check_interval_minutes': self.config.check_interval_minutes, 'started_at': self.last_check.isoformat()}
        logger.info(f"Real-time monitoring started: {result['initial_announcements']} announcements found")
        return result
    except Exception as e:
        logger.error(f'Failed to start monitoring: {e}')
        return {'monitoring_active': False, 'error': str(e)}

