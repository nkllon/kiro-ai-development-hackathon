    def _extract_affected_modules(self, stack_trace: str) -> List[str]:
        """Extract affected modules from stack trace"""
        modules = []
        for line in stack_trace.split('\n'):
            if 'File "' in line and 'src/' in line:
                try:
                    file_path = line.split('File "')[1].split('"')[0]
                    if 'src/' in file_path:
                        module = file_path.split('src/')[-1].replace('/', '.').replace('.py', '')
                        modules.append(module)
                except:
                    pass
        return list(set(modules))

    def _identify_missing_log_points(self, stack_trace: str) -> List[str]:
        """Identify where logging should be added"""
        log_points = []
        lines = stack_trace.split('\n')
        for i, line in enumerate(lines):
            if 'File "' in line and i + 1 < len(lines):
                try:
                    function_line = lines[i + 1].strip()
                    if function_line and (not function_line.startswith('File')):
                        log_points.append(f'Add logging to: {function_line}')
                except:
                    pass
        return log_points[:5]

