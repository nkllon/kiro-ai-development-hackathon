            logging.error(f"Error in method: {e}")
            raise
        """Determine if interface can be registered based on similarities"""
        # Block registration if there are exact duplicates
        exact_duplicates = [s for s in similarities if s.similarity_type == 'exact']
        if exact_duplicates:
            return False
        
        # Block registration if there are very high similarities
        very_high_similarities = [s for s in similarities if s.similarity_score >= 0.9]
        if very_high_similarities:
            return False
        
        # Allow registration with warnings for moderate similarities
        return True
    
