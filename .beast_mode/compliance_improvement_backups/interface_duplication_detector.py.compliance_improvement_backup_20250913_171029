    def _extract_interface_signature(self, file_path: str, interface_name: str) -> Optional[InterfaceSignature]:
        """Extract interface signature from file"""
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                content = f.read()
            
            tree = ast.parse(content)
            
            for node in ast.walk(tree):
                if isinstance(node, ast.ClassDef) and interface_name in node.name:
                    methods = []
                    properties = []
                    base_classes = []
                    
                    # Extract base classes
                    for base in node.bases:
                        if isinstance(base, ast.Name):
                            base_classes.append(base.id)
                    
                    # Extract methods and properties
                    for item in node.body:
                        if isinstance(item, ast.FunctionDef):
                            method_info = {
                                'name': item.name,
                                'args': [arg.arg for arg in item.args.args],
                                'returns': self._extract_return_type(item),
                                'is_abstract': any(
                                    isinstance(decorator, ast.Name) and decorator.id == 'abstractmethod'
                                    for decorator in item.decorator_list
                                ),
                                'is_property': any(
                                    isinstance(decorator, ast.Name) and decorator.id == 'property'
                                    for decorator in item.decorator_list
                                )
                            }
                            
                            if method_info['is_property']:
                                properties.append(method_info)
                            else:
                                methods.append(method_info)
                    
                    # Generate signature hash
                    signature_data = f"{interface_name}:{methods}:{properties}:{base_classes}"
                    signature_hash = hashlib.md5(signature_data.encode()).hexdigest()
                    
                    return InterfaceSignature(
                        name=interface_name,
                        methods=methods,
                        properties=properties,
                        base_classes=base_classes,
                        docstring=ast.get_docstring(node) or '',
                        file_path=file_path,
                        line_number=node.lineno,
                        signature_hash=signature_hash
                    )
            
            return None
            
        except Exception as e:
            print(f"Error extracting interface signature: {e}")
            return None
    
    def _extract_return_type(self, node: ast.FunctionDef) -> Optional[str]:
        try:
            pass  # TODO: Add method implementation
        except Exception as e:
            logging.error(f"Error in method: {e}")
            raise
        """Extract return type annotation"""
        if node.returns:
            if isinstance(node.returns, ast.Name):
                return node.returns.id
            elif isinstance(node.returns, ast.Constant):
                return str(node.returns.value)
        return None
    
