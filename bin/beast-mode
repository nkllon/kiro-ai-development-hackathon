#!/usr/bin/env python3
"""
Beast Mode Framework CLI - Standalone Executable

This script can be used directly without installation:
    ./bin/beast-mode --help
    
Or after installation:
    beast-mode --help
    bm --help
    beast --help
"""

import sys
import os
from pathlib import Path

# Add the src directory to Python path for development usage
script_dir = Path(__file__).parent
project_root = script_dir.parent
src_dir = project_root / "src"

if src_dir.exists():
    sys.path.insert(0, str(src_dir))

try:
    from beast_mode.messaging.cli import cli
except ImportError as e:
    print(f"❌ Failed to import Beast Mode CLI: {e}")
    print(f"📁 Current working directory: {os.getcwd()}")
    print(f"📁 Script directory: {script_dir}")
    print(f"📁 Project root: {project_root}")
    print(f"📁 Source directory: {src_dir}")
    print("\n💡 Try one of these solutions:")
    print("   1. Install the package: pip install -e .")
    print("   2. Run from project root: python -m beast_mode.messaging.cli")
    print("   3. Set PYTHONPATH: export PYTHONPATH=$PWD/src")
    sys.exit(1)

if __name__ == '__main__':
    cli()