# Directus CMS Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=your_secure_postgres_password_here
DB_HOST=postgres
DB_PORT=5432

# Directus Security Configuration
DIRECTUS_KEY=your_random_directus_key_here_32_chars_min
DIRECTUS_SECRET=your_random_directus_secret_here_32_chars_min

# Admin User Configuration
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_here

# API Configuration
PUBLIC_URL=http://localhost:8055
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Email Configuration (for production)
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=your_smtp_host
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_smtp_user
EMAIL_SMTP_PASSWORD=your_smtp_password

# Redis Configuration (optional)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Security Settings
RATE_LIMITER_POINTS=25
RATE_LIMITER_DURATION=1

# Logging Configuration
LOG_LEVEL=info
LOG_STYLE=pretty

# Cache Configuration
CACHE_ENABLED=true
CACHE_STORE=redis

# WebSocket Configuration
WEBSOCKETS_ENABLED=true

# File Storage Configuration
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads