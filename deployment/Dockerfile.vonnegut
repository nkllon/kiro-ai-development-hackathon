FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create data directories with proper permissions
RUN mkdir -p observatory_data/metrics \
    observatory_data/dashboards \
    observatory_data/logs \
    observatory_data/config \
    logs \
    && chmod -R 755 observatory_data logs

# Create non-root user
RUN useradd -m -u 1000 observatory && \
    chown -R observatory:observatory /app

USER observatory

# Expose port
EXPOSE 8888

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8888/health || exit 1

# Start Observatory
CMD ["python", "start_observatory.py"]