# CMS Repository Sync Service Dockerfile
FROM python:3.11-slim

LABEL maintainer="Beast Mode Framework"
LABEL description="CMS Repository Synchronization Service"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements-cms-repo-sync.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-cms-repo-sync.txt

# Copy application code
COPY src/cms_repo_sync/ ./src/cms_repo_sync/
COPY src/rm_ddd/ ./src/rm_ddd/

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/repositories

# Set Python path
ENV PYTHONPATH=/app

# Expose port
EXPOSE 8057

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8057/health || exit 1

# Run the repo sync service
CMD ["python", "-m", "src.cms_repo_sync.main"]