                description="Submit a 2-minute video demo",
                required=True,
                completed=False
            ),
            SubmissionRequirement(
                requirement_id="source_code",
                title="Source Code",
                description="Provide link to source code",
                required=True,
                completed=True
            )
        ]
        
        report = validation_engine.validate_submission_readiness(
            sample_metadata, 
            "test-hackathon", 
