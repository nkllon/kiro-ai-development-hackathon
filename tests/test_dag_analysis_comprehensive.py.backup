class TestDependencyAnalyzer:
    """Test dependency analysis functionality."""
    
    def setup_method(self):
        """Set up test fixtures."""
        self.analyzer = DependencyAnalyzer()
        
        # Create test tasks
        self.tasks = {
            "task1": TaskNode(
                task_id="task1",
                spec_name="spec1",
                task_name="Setup",
                description="Initial setup",
                estimated_effort=4,
                completion_status=TaskStatus.NOT_STARTED,
                dependencies=[]
            ),
            "task2": TaskNode(
                task_id="task2",
                spec_name="spec1", 
                task_name="Development",
                description="Core development",
                estimated_effort=16,
                completion_status=TaskStatus.NOT_STARTED,
                dependencies=["task1"]
            ),
            "task3": TaskNode(
                task_id="task3",
                spec_name="spec2",
                task_name="Testing",
                description="Quality testing",
                estimated_effort=8,
                completion_status=TaskStatus.NOT_STARTED,
                dependencies=["task2"]
            )
        }
        
        # Create test edges
        self.edges = [
            DependencyEdge("task1", "task2", "requires"),
            DependencyEdge("task2", "task3", "requires")
        ]
    
    def test_analyzer_initialization(self):
        """Test analyzer initialization."""
        assert isinstance(self.analyzer, DependencyAnalyzer)
        assert hasattr(self.analyzer, 'analyze_dependencies')
    
    def test_basic_dependency_detection(self):
        """Test basic dependency detection."""
        # Mock the analyze_dependencies method to test structure
        with patch.object(self.analyzer, 'analyze_dependencies') as mock_analyze:
            mock_analyze.return_value = {
                'dependencies': self.edges,
                'task_count': len(self.tasks),
                'dependency_count': len(self.edges)
            }
            
            result = self.analyzer.analyze_dependencies(list(self.tasks.values()))
            
            assert result['task_count'] == 3
            assert result['dependency_count'] == 2
            assert 'dependencies' in result
    
    def test_circular_dependency_detection(self):
        """Test circular dependency detection."""
        # Create circular dependency
        circular_tasks = {
            "a": TaskNode("a", "spec", "Task A", "First", 4, TaskStatus.NOT_STARTED, ["c"]),
            "b": TaskNode("b", "spec", "Task B", "Second", 4, TaskStatus.NOT_STARTED, ["a"]),
            "c": TaskNode("c", "spec", "Task C", "Third", 4, TaskStatus.NOT_STARTED, ["b"])
        }
        
        # Mock circular dependency detection
        with patch.object(self.analyzer, 'detect_circular_dependencies') as mock_detect:
            mock_detect.return_value = ["a", "b", "c"]
            
            cycles = self.analyzer.detect_circular_dependencies(list(circular_tasks.values()))
            assert len(cycles) == 3
    
    def test_dependency_chain_analysis(self):
        """Test dependency chain analysis."""
        # Test linear dependency chain
        chain_length = len(self.tasks)
        
        with patch.object(self.analyzer, 'analyze_dependency_chains') as mock_chains:
            mock_chains.return_value = {
                'longest_chain': ["task1", "task2", "task3"],
                'chain_length': chain_length,
                'parallel_opportunities': []
            }
            
            result = self.analyzer.analyze_dependency_chains(list(self.tasks.values()))
            assert result['chain_length'] == 3
            assert result['longest_chain'] == ["task1", "task2", "task3"]


class TestCriticalPathAnalyzer:
    """Test critical path analysis functionality."""
    
    def setup_method(self):
        """Set up test fixtures."""
        self.analyzer = CriticalPathAnalyzer()
        
        # Create test project with multiple paths
        self.project_tasks = {
            "start": TaskNode("start", "project", "Start", "Project start", 0, TaskStatus.COMPLETED, []),
            "design": TaskNode("design", "project", "Design", "System design", 8, TaskStatus.NOT_STARTED, ["start"]),
            "frontend": TaskNode("frontend", "project", "Frontend", "UI development", 16, TaskStatus.NOT_STARTED, ["design"]),
            "backend": TaskNode("backend", "project", "Backend", "API development", 20, TaskStatus.NOT_STARTED, ["design"]),
            "testing": TaskNode("testing", "project", "Testing", "Integration testing", 12, TaskStatus.NOT_STARTED, ["frontend", "backend"]),
            "deploy": TaskNode("deploy", "project", "Deploy", "Deployment", 4, TaskStatus.NOT_STARTED, ["testing"])
        }
    
    def test_analyzer_initialization(self):
        """Test critical path analyzer initialization."""
        assert isinstance(self.analyzer, CriticalPathAnalyzer)
        assert hasattr(self.analyzer, 'find_critical_path')
    
    def test_critical_path_calculation(self):
        """Test critical path calculation."""
        with patch.object(self.analyzer, 'find_critical_path') as mock_path:
            mock_path.return_value = {
                'path': ["start", "design", "backend", "testing", "deploy"],
                'total_duration': 44,  # 0 + 8 + 20 + 12 + 4
                'bottleneck_tasks': ["backend"]
            }
            
            result = self.analyzer.find_critical_path(list(self.project_tasks.values()))
            
            assert result['total_duration'] == 44
            assert "backend" in result['path']
            assert "backend" in result['bottleneck_tasks']
    
    def test_parallel_path_identification(self):
        """Test identification of parallel execution paths."""
        with patch.object(self.analyzer, 'identify_parallel_paths') as mock_parallel:
            mock_parallel.return_value = {
                'parallel_groups': [
                    {"tasks": ["frontend", "backend"], "can_run_parallel": True}
                ],
                'parallelization_potential': 0.6
            }
            
            result = self.analyzer.identify_parallel_paths(list(self.project_tasks.values()))
            
            assert len(result['parallel_groups']) == 1
            assert result['parallelization_potential'] > 0
    
    def test_bottleneck_identification(self):
        """Test bottleneck identification in critical path."""
        with patch.object(self.analyzer, 'identify_bottlenecks') as mock_bottlenecks:
            mock_bottlenecks.return_value = {
                'bottlenecks': [
                    {"task_id": "backend", "impact": "high", "duration": 20},
                    {"task_id": "frontend", "impact": "medium", "duration": 16}
                ],
                'optimization_suggestions': [
                    "Consider splitting backend task",
                    "Add more developers to backend team"
                ]
            }
            
            result = self.analyzer.identify_bottlenecks(list(self.project_tasks.values()))
            
            assert len(result['bottlenecks']) == 2
            assert len(result['optimization_suggestions']) > 0


class TestLayerProcessor:
    """Test layer processing functionality."""
    
    def setup_method(self):
        """Set up test fixtures."""
        self.processor = LayerProcessor()
        
        # Create layered task structure
        self.layered_tasks = {
            # Layer 0 - No dependencies
            "init1": TaskNode("init1", "layer", "Init 1", "First init", 2, TaskStatus.NOT_STARTED, []),
            "init2": TaskNode("init2", "layer", "Init 2", "Second init", 3, TaskStatus.NOT_STARTED, []),
            
            # Layer 1 - Depends on layer 0
            "proc1": TaskNode("proc1", "layer", "Process 1", "First process", 8, TaskStatus.NOT_STARTED, ["init1"]),
            "proc2": TaskNode("proc2", "layer", "Process 2", "Second process", 6, TaskStatus.NOT_STARTED, ["init2"]),
            
            # Layer 2 - Depends on layer 1
            "final": TaskNode("final", "layer", "Final", "Final task", 4, TaskStatus.NOT_STARTED, ["proc1", "proc2"])
        }
    
    def test_processor_initialization(self):
        """Test layer processor initialization."""
        assert isinstance(self.processor, LayerProcessor)
        assert hasattr(self.processor, 'process_layers')
    
    def test_layer_identification(self):
        """Test identification of dependency layers."""
        with patch.object(self.processor, 'identify_layers') as mock_layers:
            mock_layers.return_value = {
                0: ["init1", "init2"],
                1: ["proc1", "proc2"], 
                2: ["final"]
            }
            
            layers = self.processor.identify_layers(list(self.layered_tasks.values()))
            
            assert len(layers) == 3
            assert len(layers[0]) == 2  # Two init tasks
            assert len(layers[1]) == 2  # Two process tasks
            assert len(layers[2]) == 1  # One final task
    
    def test_layer_processing_order(self):
        """Test correct processing order of layers."""
        with patch.object(self.processor, 'process_layers') as mock_process:
            mock_process.return_value = {
                'processing_order': [0, 1, 2],
                'layer_durations': {0: 3, 1: 8, 2: 4},  # Max duration in each layer
                'total_sequential_time': 15
            }
            
            result = self.processor.process_layers(list(self.layered_tasks.values()))
            
            assert result['processing_order'] == [0, 1, 2]
            assert result['total_sequential_time'] == 15
    
    def test_parallel_opportunities_in_layers(self):
        """Test identification of parallel opportunities within layers."""
        with patch.object(self.processor, 'find_layer_parallelism') as mock_parallel:
            mock_parallel.return_value = {
                'parallel_layers': {
                    0: {"tasks": ["init1", "init2"], "max_duration": 3},
                    1: {"tasks": ["proc1", "proc2"], "max_duration": 8}
                },
                'parallelization_savings': 5  # Sequential would be 2+3+8+6=19, parallel is 3+8+4=15
            }
            
            result = self.processor.find_layer_parallelism(list(self.layered_tasks.values()))
            
            assert len(result['parallel_layers']) == 2
            assert result['parallelization_savings'] > 0


class TestIntegratedAnalysis:
    """Test integrated analysis scenarios."""
    
    def setup_method(self):
        """Set up integrated test scenario."""
        self.dependency_analyzer = DependencyAnalyzer()
        self.critical_path_analyzer = CriticalPathAnalyzer()
        self.layer_processor = LayerProcessor()
        
        # Complex project scenario
        self.complex_project = {
            "requirements": TaskNode("requirements", "analysis", "Requirements", "Gather requirements", 8, TaskStatus.COMPLETED, []),
            "architecture": TaskNode("architecture", "design", "Architecture", "System architecture", 16, TaskStatus.NOT_STARTED, ["requirements"]),
            "database": TaskNode("database", "backend", "Database", "Database design", 12, TaskStatus.NOT_STARTED, ["architecture"]),
            "api": TaskNode("api", "backend", "API", "API development", 24, TaskStatus.NOT_STARTED, ["database"]),
            "frontend": TaskNode("frontend", "ui", "Frontend", "UI development", 20, TaskStatus.NOT_STARTED, ["architecture"]),
            "integration": TaskNode("integration", "testing", "Integration", "Integration testing", 16, TaskStatus.NOT_STARTED, ["api", "frontend"]),
            "deployment": TaskNode("deployment", "ops", "Deployment", "Production deployment", 8, TaskStatus.NOT_STARTED, ["integration"])
        }
    
    def test_end_to_end_analysis(self):
        """Test complete end-to-end analysis workflow."""
        tasks = list(self.complex_project.values())
        
        # Mock all analysis components
        with patch.object(self.dependency_analyzer, 'analyze_dependencies') as mock_deps, \
             patch.object(self.critical_path_analyzer, 'find_critical_path') as mock_critical, \
             patch.object(self.layer_processor, 'process_layers') as mock_layers:
            
            # Set up mock returns
            mock_deps.return_value = {
                'total_tasks': len(tasks),
                'dependency_count': 6,
                'complexity_score': 0.7
            }
            
            mock_critical.return_value = {
                'path': ["requirements", "architecture", "database", "api", "integration", "deployment"],
                'total_duration': 84,
                'critical_tasks': ["api", "integration"]
            }
            
            mock_layers.return_value = {
                'layer_count': 4,
                'max_parallelism': 2,
                'optimized_duration': 68
            }
            
            # Execute analysis
            dep_result = self.dependency_analyzer.analyze_dependencies(tasks)
            critical_result = self.critical_path_analyzer.find_critical_path(tasks)
            layer_result = self.layer_processor.process_layers(tasks)
            
            # Verify integrated results
            assert dep_result['total_tasks'] == 7
            assert critical_result['total_duration'] == 84
            assert layer_result['optimized_duration'] < critical_result['total_duration']
    
    def test_optimization_recommendations(self):
        """Test generation of optimization recommendations."""
        tasks = list(self.complex_project.values())
        
        with patch.object(self.critical_path_analyzer, 'generate_optimization_recommendations') as mock_optimize:
            mock_optimize.return_value = {
                'recommendations': [
                    "Parallelize frontend and database development",
                    "Add resources to API development (critical path)",
                    "Consider splitting integration testing"
                ],
                'potential_savings': 16,  # Days that could be saved
                'risk_assessment': "medium"
            }
            
            result = self.critical_path_analyzer.generate_optimization_recommendations(tasks)
            
            assert len(result['recommendations']) >= 3
            assert result['potential_savings'] > 0
            assert result['risk_assessment'] in ["low", "medium", "high"]
    
    def test_resource_allocation_analysis(self):
        """Test resource allocation analysis."""
        tasks = list(self.complex_project.values())
        
        with patch.object(self.dependency_analyzer, 'analyze_resource_requirements') as mock_resources:
            mock_resources.return_value = {
                'total_effort': sum(task.estimated_effort for task in tasks),
                'skill_requirements': {
                    'backend_developer': 3,
                    'frontend_developer': 2,
                    'devops_engineer': 1,
                    'architect': 1
                },
                'peak_resource_demand': 4,
                'resource_utilization_timeline': {
                    'week_1': 2,
                    'week_2': 4,
                    'week_3': 3,
                    'week_4': 2
                }
            }
            
            result = self.dependency_analyzer.analyze_resource_requirements(tasks)
            
            assert result['total_effort'] == 104  # Sum of all estimated efforts
            assert result['peak_resource_demand'] == 4
            assert len(result['skill_requirements']) == 4


class TestAnalysisErrorHandling:
    """Test error handling in analysis components."""
    
    def test_empty_task_list_handling(self):
        """Test handling of empty task lists."""
        analyzer = DependencyAnalyzer()
        
        with patch.object(analyzer, 'analyze_dependencies') as mock_analyze:
            mock_analyze.return_value = {
                'total_tasks': 0,
                'dependency_count': 0,
                'message': 'No tasks to analyze'
            }
            
            result = analyzer.analyze_dependencies([])
            assert result['total_tasks'] == 0
    
    def test_invalid_dependency_handling(self):
        """Test handling of invalid dependencies."""
        analyzer = DependencyAnalyzer()
        
        # Task with dependency on non-existent task
        invalid_task = TaskNode(
            "invalid", "spec", "Invalid", "Invalid task", 
            4, TaskStatus.NOT_STARTED, ["non_existent_task"]
        )
        
        with patch.object(analyzer, 'validate_dependencies') as mock_validate:
            mock_validate.return_value = {
                'valid': False,
                'errors': ['Dependency "non_existent_task" not found'],
                'warnings': []
            }
            
            result = analyzer.validate_dependencies([invalid_task])
            assert result['valid'] is False
            assert len(result['errors']) > 0
    
    def test_performance_with_large_graphs(self):
        """Test performance with large dependency graphs."""
        analyzer = DependencyAnalyzer()
        
        # Simulate large task set
        large_task_count = 1000
        
        with patch.object(analyzer, 'analyze_dependencies') as mock_analyze:
            mock_analyze.return_value = {
                'total_tasks': large_task_count,
                'analysis_time': 0.5,  # Should complete in reasonable time
                'memory_usage': 'acceptable'
            }
            
            # Mock large task list
            large_tasks = [Mock() for _ in range(large_task_count)]
            result = analyzer.analyze_dependencies(large_tasks)
            
            assert result['total_tasks'] == large_task_count
            assert result['analysis_time'] < 1.0  # Should be fast


if __name__ == "__main__":
    pytest.main([__file__, "-v"])