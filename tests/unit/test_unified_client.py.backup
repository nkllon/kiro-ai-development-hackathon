@pytest.fixture
def mock_transport():
    """Mock transport for testing"""
    transport = AsyncMock()
    transport.initialize.return_value = True
    transport.start_daemon.return_value = True
    transport.stop_daemon.return_value = None
    transport.send_message.return_value = True
    transport.subscribe.return_value = True
    transport.get_status.return_value = {'transport_type': 'mock', 'connected': True}
    transport.get_capabilities.return_value = {'reliable_delivery': True}
    return transport


@pytest.fixture
def mock_shared_state():
    """Mock shared state for testing"""
    shared_state = AsyncMock()
    shared_state.initialize.return_value = True
    shared_state.update_agent_state.return_value = True
    shared_state.remove_agent_state.return_value = True
    shared_state.increment_counter.return_value = 1
    shared_state.get_active_agents.return_value = ['agent1', 'agent2']
    shared_state.get_agent_state.return_value = {'status': 'online'}
    shared_state.shutdown.return_value = None
    return shared_state


@pytest.fixture
def unified_client(mock_transport, mock_shared_state):
    """Create unified client with mocked dependencies"""
    with patch('src.beast_mode.messaging.unified_client.TransportFactory') as mock_factory:
        with patch('src.beast_mode.messaging.unified_client.BeastModeSharedState') as mock_state_class:
            mock_factory.create_transport.return_value = mock_transport
            mock_state_class.return_value = mock_shared_state
            
            client = BeastModeClient(
                agent_id='test_agent',
                transport_type='redis',
                capabilities=['testing', 'mocking'],
                specializations=['unit_tests']
            )
            
            return client


@pytest.mark.asyncio
async def test_client_initialization(unified_client):
    """Test client initialization"""
    assert unified_client.agent_id == 'test_agent'
    assert unified_client.transport_type == 'redis'
    assert unified_client.capabilities == ['testing', 'mocking']
    assert unified_client.specializations == ['unit_tests']
    assert not unified_client.is_started


@pytest.mark.asyncio
async def test_client_start(unified_client, mock_transport, mock_shared_state):
    """Test starting the client"""
    result = await unified_client.start()
    
    assert result is True
    assert unified_client.is_started is True
    
    # Verify initialization sequence
    mock_shared_state.initialize.assert_called_once()
    mock_transport.initialize.assert_called_once()
    mock_transport.subscribe.assert_called_once()
    mock_transport.start_daemon.assert_called_once()
    mock_shared_state.update_agent_state.assert_called()


@pytest.mark.asyncio
async def test_client_stop(unified_client, mock_transport, mock_shared_state):
    """Test stopping the client"""
    # Start first
    await unified_client.start()
    
    # Then stop
    await unified_client.stop()
    
    assert unified_client.is_started is False
    
    # Verify shutdown sequence
    mock_shared_state.remove_agent_state.assert_called_with('test_agent')
    mock_transport.stop_daemon.assert_called_once()
    mock_shared_state.shutdown.assert_called_once()


@pytest.mark.asyncio
async def test_send_message(unified_client, mock_transport, mock_shared_state):
    """Test sending messages"""
    await unified_client.start()
    
    message = BeastModeMessage(
        type=MessageType.SIMPLE_MESSAGE,
        source='test_agent',
        payload={'text': 'test message'}
    )
    
    result = await unified_client.send_message(message)
    
    assert result is True
    mock_transport.send_message.assert_called_once_with(message)
    mock_shared_state.increment_counter.assert_called_with('messages_sent', 'test_agent')
    mock_shared_state.update_agent_state.assert_called()


@pytest.mark.asyncio
async def test_message_handling(unified_client):
    """Test message handling with registered handlers"""
    handler_calls = []
    
    def test_handler(message):
        handler_calls.append(message)
    
    # Register handler
    unified_client.register_handler(MessageType.SIMPLE_MESSAGE, test_handler)
    
    # Simulate receiving a message
    test_message = BeastModeMessage(
        type=MessageType.SIMPLE_MESSAGE,
        source='other_agent',
        payload={'text': 'incoming message'}
    )
    
    await unified_client._handle_message(test_message)
    
    # Verify handler was called
    assert len(handler_calls) == 1
    assert handler_calls[0].payload['text'] == 'incoming message'


