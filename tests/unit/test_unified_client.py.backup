@pytest.mark.asyncio
async def test_builtin_agent_discovery(unified_client, mock_transport):
    """Test built-in agent discovery response"""
    await unified_client.start()
    
    # Simulate agent discovery message
    discovery_message = BeastModeMessage(
        type=MessageType.AGENT_DISCOVERY,
        source='discovering_agent',
        payload={'requesting_info': True}
    )
    
    await unified_client._handle_message(discovery_message)
    
    # Verify response was sent
    assert mock_transport.send_message.call_count >= 1
    
    # Check the response message
    sent_calls = mock_transport.send_message.call_args_list
    response_call = sent_calls[-1]  # Last call should be the response
    response_message = response_call[0][0]
    
    assert response_message.type == MessageType.AGENT_RESPONSE
    assert response_message.target == 'discovering_agent'
    assert response_message.payload['agent_id'] == 'test_agent'


