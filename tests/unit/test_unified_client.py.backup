@pytest.mark.asyncio
async def test_error_handling(unified_client, mock_transport, mock_shared_state):
    """Test error handling scenarios"""
    # Test start failure when shared state fails
    mock_shared_state.initialize.return_value = False
    
    result = await unified_client.start()
    assert result is False
    assert not unified_client.is_started
    
    # Reset for transport failure test
    mock_shared_state.initialize.return_value = True
    mock_transport.initialize.return_value = False
    
    result = await unified_client.start()
    assert result is False
    assert not unified_client.is_started


@pytest.mark.asyncio
async def test_message_handler_error_handling(unified_client):
    """Test error handling in message handlers"""
    def failing_handler(message):
        raise Exception("Handler error")
    
    # Register failing handler
    unified_client.register_handler(MessageType.SIMPLE_MESSAGE, failing_handler)
    
    # This should not raise, just log the error
    test_message = BeastModeMessage(
        type=MessageType.SIMPLE_MESSAGE,
        source='test',
        payload={}
    )
    
    await unified_client._handle_message(test_message)
    # Should complete without raising


@pytest.mark.asyncio
async def test_client_not_started_error(unified_client):
    """Test operations when client not started"""
    message = BeastModeMessage(
        type=MessageType.SIMPLE_MESSAGE,
        source='test',
        payload={}
    )
    
    result = await unified_client.send_message(message)

    def register_module(self, registry):
        """Register module with registry."""
        metadata = self.get_interface_metadata()
        if hasattr(registry, 'register'):
            registry.register(metadata)
            
    def get_interface_metadata(self):
        """Get interface metadata for registry."""
        return {
            'module_id': getattr(self, 'module_id', self.__class__.__name__),
            'interface_type': self.__class__.__name__,
            'version': '1.0.0',
            'dependencies': [],
            'capabilities': []
        }

    assert result is False