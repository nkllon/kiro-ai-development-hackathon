import json
import pytest
from datetime import datetime, timedelta
from unittest.mock import Mock

from src.beast_mode.messaging.message_models import (
    MessageType, AgentCapability, BeastModeMessage, AgentCapabilities,
    create_agent_announcement, create_help_request, create_spore_share,
    create_heartbeat, validate_message_chain, filter_messages_by_capability,
    PYDANTIC_AVAILABLE
)


class TestMessageType:
    """Test MessageType enum."""
    
    def test_message_type_values(self):
        """Test all message type values are strings."""
        for msg_type in MessageType:
            assert isinstance(msg_type.value, str)
            assert len(msg_type.value) > 0
    
    def test_discovery_message_types(self):
        """Test discovery-related message types."""
        discovery_types = [
            MessageType.AGENT_ANNOUNCEMENT,
            MessageType.CAPABILITY_BROADCAST,
            MessageType.DISCOVERY_REQUEST,
            MessageType.DISCOVERY_RESPONSE
        ]
        
        for msg_type in discovery_types:
            assert msg_type in MessageType
    
    def test_collaboration_message_types(self):
        """Test collaboration-related message types."""
        collab_types = [
            MessageType.HELP_REQUEST,
            MessageType.HELP_RESPONSE,
            MessageType.COLLABORATION_INVITE,
            MessageType.TASK_ASSIGNMENT
        ]
        
        for msg_type in collab_types:
            assert msg_type in MessageType


class TestAgentCapability:
    """Test AgentCapability enum."""
    
    def test_capability_categories(self):
        """Test capability categories are present."""
        analysis_caps = [
            AgentCapability.CODE_ANALYSIS,
            AgentCapability.SECURITY_ANALYSIS,
            AgentCapability.PERFORMANCE_ANALYSIS
        ]
        
        dev_caps = [
            AgentCapability.CODE_GENERATION,
            AgentCapability.TEST_GENERATION,
            AgentCapability.DOCUMENTATION_GENERATION
        ]
        
        for cap in analysis_caps + dev_caps:
            assert cap in AgentCapability
    
    def test_capability_values_are_strings(self):
        """Test all capability values are strings."""
        for capability in AgentCapability:
            assert isinstance(capability.value, str)
            assert "_" in capability.value or capability.value.islower()


class TestAgentCapabilities:
    """Test AgentCapabilities model."""
    
    @pytest.fixture
    def sample_capabilities(self):
        """Sample agent capabilities for testing."""
        return AgentCapabilities(
            agent_id="test_agent_001",
            agent_name="Test Agent",
            capabilities=[
                AgentCapability.CODE_ANALYSIS,
                AgentCapability.SECURITY_ANALYSIS
            ],
            specializations=["Python", "Security"],
            max_concurrent_tasks=5,
            trust_score=0.8
        )
    
    def test_capabilities_creation(self, sample_capabilities):
        """Test capabilities model creation."""
        assert sample_capabilities.agent_id == "test_agent_001"
        assert sample_capabilities.agent_name == "Test Agent"
        assert len(sample_capabilities.capabilities) == 2
        assert sample_capabilities.trust_score == 0.8
    
    def test_capabilities_defaults(self):
        """Test default values for capabilities."""
        caps = AgentCapabilities(
            agent_id="test",
            agent_name="Test"
        )
        
        assert caps.capabilities == []
        assert caps.specializations == []
        assert caps.availability == "available"
        assert caps.max_concurrent_tasks == 3
        assert caps.current_load == 0
        assert caps.trust_score == 0.5
    
    @pytest.mark.skipif(not PYDANTIC_AVAILABLE, reason="Pydantic not available")
    def test_capabilities_validation(self):
        """Test capabilities validation with Pydantic."""
        # Test invalid agent ID
        with pytest.raises(ValueError, match="Agent ID must be at least 3 characters"):
            AgentCapabilities(agent_id="ab", agent_name="Test")
        
        # Test empty capabilities validation
        with pytest.raises(ValueError, match="Agent must have at least one capability"):
            AgentCapabilities(
                agent_id="test_agent",
                agent_name="Test",
                capabilities=[]
            )


class TestBeastModeMessage:
    """Test BeastModeMessage model."""
    
    @pytest.fixture
    def sample_message(self):
        """Sample message for testing."""
        return BeastModeMessage(
            message_type=MessageType.HELP_REQUEST,
            sender_id="agent_001",
            recipient_id="agent_002",
            subject="Need help with code analysis",
            content={"description": "Analyze this Python code", "code": "print('hello')"},
            priority="high",
            requires_response=True
        )
    
    def test_message_creation(self, sample_message):
        """Test message model creation."""
        assert sample_message.message_type == MessageType.HELP_REQUEST
        assert sample_message.sender_id == "agent_001"
        assert sample_message.recipient_id == "agent_002"
        assert sample_message.requires_response is True
        assert sample_message.priority == "high"
    
    def test_message_defaults(self):
        """Test message default values."""
        msg = BeastModeMessage(
            message_type=MessageType.HEARTBEAT,
            sender_id="test_agent"
        )
        
        assert msg.channel == "beast_mode_general"
        assert msg.priority == "normal"
        assert msg.requires_response is False
        assert msg.capabilities_required == []
        assert msg.spore_references == []
        assert msg.attachments == []
        assert len(msg.message_id) > 0
        assert isinstance(msg.timestamp, datetime)
    
    @pytest.mark.skipif(not PYDANTIC_AVAILABLE, reason="Pydantic not available")
    def test_message_validation(self):
        """Test message validation with Pydantic."""
        # Test invalid priority
        with pytest.raises(ValueError, match="Priority must be one of"):
            BeastModeMessage(
                message_type=MessageType.HEARTBEAT,
                sender_id="test",
                priority="invalid"
            )
        
        # Test non-serializable content
        with pytest.raises(ValueError, match="must be JSON serializable"):
            BeastModeMessage(
                message_type=MessageType.HEARTBEAT,
                sender_id="test",
                content={"func": lambda x: x}  # Functions aren't serializable
            )
    
    def test_message_serialization(self, sample_message):
        """Test message serialization to dict and JSON."""
        # Test to_dict
        msg_dict = sample_message.to_dict()
        assert isinstance(msg_dict, dict)
        assert msg_dict["message_type"] == "help_request"
        assert msg_dict["sender_id"] == "agent_001"
        
        # Test to_json
        msg_json = sample_message.to_json()
        assert isinstance(msg_json, str)
        
        # Test round-trip
        parsed_dict = json.loads(msg_json)
        assert parsed_dict["sender_id"] == "agent_001"
    
    def test_message_deserialization(self, sample_message):
        """Test message deserialization from dict and JSON."""
        # Test from_dict
        msg_dict = sample_message.to_dict()
        restored_msg = BeastModeMessage.from_dict(msg_dict)
        assert restored_msg.sender_id == sample_message.sender_id
        assert restored_msg.message_type == sample_message.message_type
        
        # Test from_json
        msg_json = sample_message.to_json()
        if PYDANTIC_AVAILABLE:
            restored_msg = BeastModeMessage.from_json(msg_json)
            assert restored_msg.sender_id == sample_message.sender_id
    
    def test_create_reply(self, sample_message):
        """Test reply message creation."""
        reply = sample_message.create_reply(
            sender_id="agent_002",
            content={"response": "I can help with that"},
            message_type=MessageType.HELP_RESPONSE
        )
        
        assert reply.message_type == MessageType.HELP_RESPONSE
        assert reply.sender_id == "agent_002"
        assert reply.recipient_id == "agent_001"  # Original sender
        assert reply.reply_to == sample_message.message_id
        assert reply.channel == sample_message.channel
    
    def test_message_expiration(self):
        """Test message expiration functionality."""
        # Test non-expiring message
        msg = BeastModeMessage(
            message_type=MessageType.HEARTBEAT,
            sender_id="test"
        )
        assert not msg.is_expired()
        
        # Test expired message
        past_time = datetime.now() - timedelta(hours=1)
        msg.expires_at = past_time
        assert msg.is_expired()
        
        # Test future expiration
        future_time = datetime.now() + timedelta(hours=1)
        msg.expires_at = future_time
        assert not msg.is_expired()
    
    def test_message_age(self, sample_message):
        """Test message age calculation."""
        age = sample_message.get_age_seconds()
        assert isinstance(age, float)
        assert age >= 0


class TestMessageFactories:
    """Test message factory functions."""
    
    def test_create_agent_announcement(self):
        """Test agent announcement creation."""
        capabilities = AgentCapabilities(
            agent_id="test_agent",
            agent_name="Test Agent",
            capabilities=[AgentCapability.CODE_ANALYSIS]
        )
        
        msg = create_agent_announcement("test_agent", capabilities)
        
        assert msg.message_type == MessageType.AGENT_ANNOUNCEMENT
        assert msg.sender_id == "test_agent"
        assert "Test Agent" in msg.subject
        assert "capabilities" in msg.content
    
    def test_create_help_request(self):
        """Test help request creation."""
        required_caps = [AgentCapability.CODE_ANALYSIS, AgentCapability.SECURITY_ANALYSIS]
        
        msg = create_help_request(
            sender_id="requester",
            required_capabilities=required_caps,
            description="Need code review",
            priority="high"
        )
        
        assert msg.message_type == MessageType.HELP_REQUEST
        assert msg.sender_id == "requester"
        assert msg.priority == "high"
        assert msg.requires_response is True
        assert msg.capabilities_required == required_caps
        assert "Need code review" in msg.content["description"]
    
    def test_create_spore_share(self):
        """Test spore sharing message creation."""
        spore_data = {
            "name": "Test Spore",
            "version": "1.0",
            "methodology": "Test methodology"
        }
        
        msg = create_spore_share("sharer", "spore_123", spore_data)
        
        assert msg.message_type == MessageType.SPORE_SHARE
        assert msg.sender_id == "sharer"
        assert "spore_123" in msg.subject
        assert msg.content["spore_id"] == "spore_123"
        assert msg.content["spore_data"] == spore_data
        assert "spore_123" in msg.spore_references
    
    def test_create_heartbeat(self):
        """Test heartbeat message creation."""
        status_info = {
            "cpu_usage": 45.2,
            "memory_usage": 67.8,
            "active_tasks": 3
        }
        
        msg = create_heartbeat("agent_001", status_info)
        
        assert msg.message_type == MessageType.HEARTBEAT
        assert msg.sender_id == "agent_001"
        assert msg.content["status"] == status_info
        assert msg.expires_at is not None  # Should have expiration


class TestMessageUtilities:
    """Test message utility functions."""
    
    def test_validate_message_chain(self):
        """Test message chain validation."""
        # Create a valid message chain
        msg1 = BeastModeMessage(
            message_type=MessageType.HELP_REQUEST,
            sender_id="agent_001"
        )
        
        msg2 = msg1.create_reply(
            sender_id="agent_002",
            content={"response": "I can help"}
        )
        
        msg3 = msg2.create_reply(
            sender_id="agent_001", 
            content={"thanks": "Great!"}
        )
        
        # Test valid chain
        assert validate_message_chain([msg1, msg2, msg3]) is True
        
        # Test empty chain
        assert validate_message_chain([]) is True
        
        # Test single message
        assert validate_message_chain([msg1]) is True
    
    def test_validate_broken_message_chain(self):
        """Test validation of broken message chain."""
        msg1 = BeastModeMessage(
            message_type=MessageType.HELP_REQUEST,
            sender_id="agent_001"
        )
        
        msg2 = BeastModeMessage(
            message_type=MessageType.HELP_RESPONSE,
            sender_id="agent_002",
            correlation_id="different_id"  # Wrong correlation ID
        )
        
        # Test broken chain
        assert validate_message_chain([msg1, msg2]) is False
    
    def test_filter_messages_by_capability(self):
        """Test filtering messages by agent capabilities."""
        # Create messages with different capability requirements
        msg1 = BeastModeMessage(
            message_type=MessageType.HELP_REQUEST,
            sender_id="requester",
            capabilities_required=[AgentCapability.CODE_ANALYSIS]
        )
        
        msg2 = BeastModeMessage(
            message_type=MessageType.HELP_REQUEST,
            sender_id="requester",
            capabilities_required=[AgentCapability.SECURITY_ANALYSIS]
        )
        
        msg3 = BeastModeMessage(
            message_type=MessageType.HEARTBEAT,
            sender_id="agent",
            capabilities_required=[]  # No requirements
        )
        
        messages = [msg1, msg2, msg3]
        
        # Agent with code analysis capability
        agent_caps = [AgentCapability.CODE_ANALYSIS]
        filtered = filter_messages_by_capability(messages, agent_caps)
        
        assert len(filtered) == 2  # msg1 and msg3
        assert msg1 in filtered
        assert msg3 in filtered
        assert msg2 not in filtered
        
        # Agent with no specific capabilities
        filtered_empty = filter_messages_by_capability(messages, [])
        assert len(filtered_empty) == 1  # Only msg3 (no requirements)
        assert msg3 in filtered_empty