    rdfs:label "has business impact level"@en .

risk:affects a owl:ObjectProperty ;
    rdfs:domain risk:Risk ;
    rdfs:range infra:Component ;
    rdfs:label "affects component"@en .

risk:mitigatedBy a owl:ObjectProperty ;
    rdfs:domain risk:Risk ;
    rdfs:range exec:Solution ;
    rdfs:label "mitigated by solution"@en .

# Constraint Properties
const:constrains a owl:ObjectProperty ;
    rdfs:domain const:Constraint ;
    rdfs:range exec:Solution ;
    rdfs:label "constrains solution implementation"@en .

const:hasConstraintType a owl:DatatypeProperty ;
    rdfs:domain const:Constraint ;
    rdfs:range xsd:string ;
    rdfs:label "has constraint type"@en .

const:hasConstraintValue a owl:DatatypeProperty ;
    rdfs:domain const:Constraint ;
    rdfs:range xsd:string ;
    rdfs:label "has constraint value"@en .

# Performance Properties
perf:measuredBy a owl:ObjectProperty ;
    rdfs:domain infra:Component ;
    rdfs:range perf:PerformanceMetric ;
    rdfs:label "measured by performance metric"@en .

perf:hasBaseline a owl:DatatypeProperty ;
    rdfs:domain perf:PerformanceMetric ;
    rdfs:range xsd:decimal ;
