# ================================
# OPERATIONAL PROCEDURE INSTANCES
# ================================

ops:WebSocketHealthCheckProcedure a ops:MonitoringProcedure ;
    rdfs:label "WebSocket Endpoint Health Check Procedure"@en ;
    ops:hasFrequency "every_30_seconds" ;
    ops:hasValidationCommand "wscat -c wss://observatory.nkllon.com/ws/observatory --execute 'ping'" ;
    ops:hasExpectedResponse "pong response within 5 seconds" .

ops:TunnelRestartProcedure a ops:IncidentResponse ;
    rdfs:label "Cloudflare Tunnel Emergency Restart Procedure"@en ;
    ops:hasExecutionSteps """
1. Verify tunnel status: systemctl status cloudflared
2. Check tunnel logs: journalctl -u cloudflared -f
3. Backup current configuration: cp ~/.cloudflared/config.yml ~/.cloudflared/config.yml.backup
4. Restart tunnel service: sudo systemctl restart cloudflared
5. Verify connectivity: curl -I https://observatory.nkllon.com
6. Test WebSocket endpoints: wscat -c wss://observatory.nkllon.com/ws/observatory
7. Monitor for 10 minutes to ensure stability
8. Document incident and root cause""" ;
    time:hasDuration "PT10M"^^xsd:duration .

ops:PerformanceMonitoringProcedure a ops:MonitoringProcedure ;
    rdfs:label "WebSocket Performance Monitoring Procedure"@en ;
    ops:hasFrequency "continuous" ;
    ops:hasMetricCollection "Prometheus scraping every 15 seconds" ;
    ops:hasAlertingRules "Grafana alerts with 30-second evaluation intervals" .

ops:ConfigurationBackupProcedure a ops:BackupProcedure ;
    rdfs:label "Infrastructure Configuration Backup Procedure"@en ;
    ops:hasFrequency "before_every_change" ;
    ops:hasExecutionSteps """
1. Backup cloudflared config: cp ~/.cloudflared/config.yml ~/.cloudflared/config.yml.$(date +%Y%m%d_%H%M%S)
2. Backup nginx config: sudo cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.backup
3. Export Cloudflare DNS settings: cf-terraforming generate --resource-type cloudflare_record
4. Backup monitoring configuration: tar -czf monitoring_backup_$(date +%Y%m%d).tar.gz /etc/prometheus/ /etc/grafana/
5. Store backups in version control: git add . && git commit -m "Config backup $(date)"
6. Verify backup integrity: diff original backup""" .

ops:IncidentEscalationProcedure a ops:IncidentResponse ;
    rdfs:label "WebSocket Incident Escalation Procedure"@en ;
    ops:hasEscalationLevels """
Level 1 (0-5 minutes): Automated restart attempts and basic remediation
Level 2 (5-15 minutes): Engineer notification and manual intervention
Level 3 (15-30 minutes): Senior engineer escalation and emergency response
Level 4 (30+ minutes): Executive notification and vendor escalation""" ;
    ops:hasContactProcedure "PagerDuty integration with SMS and voice notifications" .

