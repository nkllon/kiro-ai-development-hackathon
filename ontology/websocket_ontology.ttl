@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Observatory WebSocket Infrastructure Ontology Namespaces
@prefix obs: <http://observatory.nkllon.com/ontology#> .
@prefix ws: <http://observatory.nkllon.com/ontology/websocket#> .
@prefix cf: <http://observatory.nkllon.com/ontology/cloudflare#> .
@prefix infra: <http://observatory.nkllon.com/ontology/infrastructure#> .
@prefix monitor: <http://observatory.nkllon.com/ontology/monitoring#> .
@prefix exec: <http://observatory.nkllon.com/ontology/execution#> .
@prefix risk: <http://observatory.nkllon.com/ontology/risk#> .
@prefix const: <http://observatory.nkllon.com/ontology/constraints#> .
@prefix perf: <http://observatory.nkllon.com/ontology/performance#> .
@prefix sec: <http://observatory.nkllon.com/ontology/security#> .
@prefix cost: <http://observatory.nkllon.com/ontology/cost#> .
@prefix dep: <http://observatory.nkllon.com/ontology/dependencies#> .
@prefix scale: <http://observatory.nkllon.com/ontology/scalability#> .
@prefix ops: <http://observatory.nkllon.com/ontology/operations#> .
@prefix comp: <http://observatory.nkllon.com/ontology/compliance#> .
@prefix arch: <http://observatory.nkllon.com/ontology/architecture#> .
@prefix net: <http://observatory.nkllon.com/ontology/network#> .
@prefix data: <http://observatory.nkllon.com/ontology/data#> .
@prefix user: <http://observatory.nkllon.com/ontology/user#> .
@prefix vendor: <http://observatory.nkllon.com/ontology/vendor#> .
@prefix maint: <http://observatory.nkllon.com/ontology/maintenance#> .
@prefix legal: <http://observatory.nkllon.com/ontology/legal#> .

# ================================
# ONTOLOGY METADATA & VALIDATION
# ================================

obs: a owl:Ontology ;
    rdfs:label "Observatory WebSocket Infrastructure Multi-Dimensional Ontology"@en ;
    rdfs:comment "Complete 22-dimensional knowledge graph for WebSocket cascade failure analysis and resolution"@en ;
    dc:title "WebSocket Infrastructure Problem Space Ontology" ;
    dc:creator "Claude & Lou Springer" ;
    dc:date "2025-09-26" ;
    dc:description "Comprehensive ontological framework covering problem diagnosis, solution architecture, risk assessment, and operational constraints for WebSocket infrastructure failures" ;
    owl:versionInfo "2.0.0" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:language "en" ;
    exec:executionTarget "PT2H"^^xsd:duration ;
    exec:confidenceLevel "0.95"^^xsd:decimal ;
    exec:validationMethod "runtime_telemetry" ;
    exec:dimensionCount "22"^^xsd:integer ;
    prov:wasGeneratedBy obs:OntologyCreationActivity .

# Ontology creation provenance
obs:OntologyCreationActivity a prov:Activity ;
    prov:startedAtTime "2025-09-26T00:00:00Z"^^xsd:dateTime ;
    prov:used obs:DiagnosticFlowchart, obs:EvidenceDocument ;
    prov:wasAssociatedWith obs:ClaudeAgent, obs:LouSpringer .

# ================================
# DIMENSION 1: PROBLEM TAXONOMY
# ================================

ws:Problem a owl:Class ;
    rdfs:label "WebSocket Problem"@en ;
    rdfs:comment "Root class for all WebSocket-related infrastructure issues"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ws:hasSymptom ;
        owl:someValuesFrom xsd:string
    ] .

ws:CascadeFailure a owl:Class ;
    rdfs:subClassOf ws:Problem ;
    rdfs:label "Cascade Failure"@en ;
    rdfs:comment "System failure where one component triggers failures in dependent components"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            ws:Problem
            [a owl:Restriction ; owl:onProperty ws:triggersFailure ; owl:minCardinality "1"^^xsd:nonNegativeInteger]
        )
    ] .

ws:TunnelFailure a owl:Class ;
    rdfs:subClassOf ws:Problem ;
    rdfs:label "Tunnel Infrastructure Failure"@en ;
    rdfs:comment "Cloudflare tunnel-specific WebSocket connectivity failures"@en .

ws:ProtocolDowngrade a owl:Class ;
    rdfs:subClassOf ws:TunnelFailure ;
    rdfs:label "WebSocket Protocol Downgrade"@en ;
    rdfs:comment "WebSocket upgrade request improperly downgraded to HTTP/2"@en .

ws:PollingFallback a owl:Class ;
    rdfs:subClassOf ws:Problem ;
    rdfs:label "Aggressive HTTP Polling Fallback"@en ;
    rdfs:comment "High-frequency HTTP polling triggered by WebSocket connection failure"@en .

ws:BotProtectionTrigger a owl:Class ;
    rdfs:subClassOf ws:Problem ;
    rdfs:label "Bot Protection System Activation"@en ;
    rdfs:comment "Automated security systems triggered by suspicious traffic patterns"@en .

# ================================
# DIMENSION 2: INFRASTRUCTURE TOPOLOGY
# ================================

infra:Component a owl:Class ;
    rdfs:label "Infrastructure Component"@en ;
    rdfs:comment "Any physical or logical component in the system infrastructure"@en .

infra:NetworkComponent a owl:Class ;
    rdfs:subClassOf infra:Component ;
    rdfs:label "Network Infrastructure Component"@en .

infra:ComputeComponent a owl:Class ;
    rdfs:subClassOf infra:Component ;
    rdfs:label "Compute Infrastructure Component"@en .

infra:StorageComponent a owl:Class ;
    rdfs:subClassOf infra:Component ;
    rdfs:label "Storage Infrastructure Component"@en .

cf:Tunnel a owl:Class ;
    rdfs:subClassOf infra:NetworkComponent ;
    rdfs:label "Cloudflare Tunnel"@en ;
    rdfs:comment "Cloudflare's secure tunnel service for exposing local services"@en .

cf:EdgeServer a owl:Class ;
    rdfs:subClassOf infra:NetworkComponent ;
    rdfs:label "Cloudflare Edge Server"@en ;
    rdfs:comment "Cloudflare's globally distributed edge computing nodes"@en .

cf:Dashboard a owl:Class ;
    rdfs:subClassOf infra:Component ;
    rdfs:label "Cloudflare Management Dashboard"@en .

cf:BotProtection a owl:Class ;
    rdfs:subClassOf infra:Component ;
    rdfs:label "Cloudflare Bot Protection System"@en .

ws:Endpoint a owl:Class ;
    rdfs:subClassOf infra:NetworkComponent ;
    rdfs:label "WebSocket Communication Endpoint"@en .

# ================================
# DIMENSION 3: SOLUTION ARCHITECTURE
# ================================

exec:Solution a owl:Class ;
    rdfs:label "Implementation Solution"@en ;
    rdfs:comment "Actionable solution to address identified problems"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty exec:solveProblem ;
        owl:someValuesFrom ws:Problem
    ] .

exec:ImmediateFix a owl:Class ;
    rdfs:subClassOf exec:Solution ;
    rdfs:label "Immediate Fix Solution"@en ;
    rdfs:comment "Solution implementable within 2 hours with existing resources"@en ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty exec:hasImplementationTime ;
        owl:hasValue "PT2H"^^xsd:duration ;
        owl:onClass time:Duration
    ] .

exec:ProgressiveSolution a owl:Class ;
    rdfs:subClassOf exec:Solution ;
    rdfs:label "Progressive Implementation Solution"@en ;
    rdfs:comment "Solution requiring 2-4 weeks phased implementation"@en .

exec:AlternativeArchitecture a owl:Class ;
    rdfs:subClassOf exec:Solution ;
    rdfs:label "Alternative Infrastructure Architecture"@en ;
    rdfs:comment "Complete architectural replacement requiring 1-3 months"@en .

arch:HybridArchitecture a owl:Class ;
    rdfs:subClassOf exec:ProgressiveSolution ;
    rdfs:label "Hybrid WebSocket Architecture"@en ;
    rdfs:comment "Architecture combining direct connections with CDN benefits"@en .

arch:MultiRegionArchitecture a owl:Class ;
    rdfs:subClassOf exec:AlternativeArchitecture ;
    rdfs:label "Multi-Region Distributed Architecture"@en .

