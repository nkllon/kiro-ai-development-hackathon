    rdfs:label "Technical Implementation Risk"@en .

risk:BusinessRisk a owl:Class ;
    rdfs:subClassOf risk:Risk ;
    rdfs:label "Business Impact Risk"@en .

risk:SecurityRisk a owl:Class ;
    rdfs:subClassOf risk:Risk ;
    rdfs:label "Security Vulnerability Risk"@en .

risk:OperationalRisk a owl:Class ;
    rdfs:subClassOf risk:Risk ;
    rdfs:label "Operational Continuity Risk"@en .

risk:VendorLockInRisk a owl:Class ;
    rdfs:subClassOf risk:BusinessRisk ;
    rdfs:label "Vendor Lock-in Risk"@en ;
    rdfs:comment "Risk of dependency on single vendor technology stack"@en .

risk:SinglePointOfFailure a owl:Class ;
    rdfs:subClassOf risk:TechnicalRisk ;
    rdfs:label "Single Point of Failure Risk"@en .

risk:DataLossRisk a owl:Class ;
    rdfs:subClassOf risk:TechnicalRisk ;
    rdfs:label "Data Loss Risk"@en .

risk:ServiceDowntimeRisk a owl:Class ;
    rdfs:subClassOf risk:OperationalRisk ;
    rdfs:label "Service Downtime Risk"@en .

