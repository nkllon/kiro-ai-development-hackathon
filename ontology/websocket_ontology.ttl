# ================================
# PROGRESSIVE SOLUTION INSTANCES
# ================================

arch:HybridWebSocketArchitecture a arch:HybridArchitecture ;
    rdfs:label "Hybrid WebSocket Direct/CDN Architecture"@en ;
    exec:solveProblem ws:ObservatoryWebSocketCascadeFailure ;
    exec:hasImplementationTime "P14D"^^xsd:duration ;
    exec:hasConfidenceLevel "0.85"^^xsd:decimal ;
    exec:requiresExternalDependency true ;
    exec:introducesRisk risk:ComplexityManagementRisk ;
    exec:mitigatesRisk risk:SinglePointOfFailureTunnel ;
    cost:hasCostValue "150.0"^^xsd:decimal ;
    cost:hasCostUnit "USD_per_month" ;
    infra:hasConfiguration """
# DNS Configuration Strategy
ws.observatory.nkllon.com -> Direct IP (A record, grey cloud)
observatory.nkllon.com -> Cloudflare tunnel (CNAME, orange cloud)

# nginx WebSocket Proxy Configuration
upstream websocket_backend {
    server localhost:8888;
    keepalive 64;
}

server {
    listen 443 ssl;
    server_name ws.observatory.nkllon.com;
    
    location /ws/ {
        proxy_pass http://websocket_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
}

# Client-side Endpoint Selection
const getWebSocketURL = (endpoint) => {
    const isDirect = localStorage.getItem('ws_prefer_direct') === 'true';
    const baseURL = isDirect ? 'wss://ws.observatory.nkllon.com' : 'wss://observatory.nkllon.com';
    return `${baseURL}/ws/${endpoint}`;
};""" ;
    arch:hasFailoverStrategy "Automatic fallback to tunnel on direct connection failure" ;
    perf:hasTarget "50.0"^^xsd:decimal .

arch:MultiRegionWebSocketArchitecture a arch:MultiRegionArchitecture ;
    rdfs:label "Multi-Region WebSocket Distribution Architecture"@en ;
    exec:solveProblem risk:PerformanceDegradationRisk, risk:SinglePointOfFailureTunnel ;
    exec:hasImplementationTime "P21D"^^xsd:duration ;
    exec:hasConfidenceLevel "0.80"^^xsd:decimal ;
    exec:requiresExternalDependency true ;
    cost:hasCostValue "300.0"^^xsd:decimal ;
    cost:hasCostUnit "USD_per_month" ;
    scale:hasHorizontalScaling "Regional server instances" ;
    scale:hasGeographicScaling "US, EU, APAC regions" ;
    infra:hasConfiguration """
# Regional WebSocket Endpoints
us-ws.observatory.nkllon.com -> US East (Virginia) server
eu-ws.observatory.nkllon.com -> EU West (Ireland) server
ap-ws.observatory.nkllon.com -> Asia Pacific (Singapore) server

# GeoDNS Configuration
ws.observatory.nkllon.com -> GeoDNS routing based on client location

# Client-side Regional Selection
const getOptimalWebSocketEndpoint = async () => {
    const endpoints = [
        'wss://us-ws.observatory.nkllon.com/ws/observatory',
        'wss://eu-ws.observatory.nkllon.com/ws/observatory',
        'wss://ap-ws.observatory.nkllon.com/ws/observatory'
    ];
    
    // Test latency to each endpoint
    const latencyTests = await Promise.allSettled(
        endpoints.map(async (url) => {
            const start = performance.now();
            const ws = new WebSocket(url);
            await new Promise((resolve, reject) => {
                ws.onopen = resolve;
                ws.onerror = reject;
                setTimeout(reject, 5000); // 5s timeout
            });
            ws.close();
            return { url, latency: performance.now() - start };
        })
    );
    
    // Return endpoint with lowest latency
    const successful = latencyTests
        .filter(result => result.status === 'fulfilled')
        .map(result => result.value)
        .sort((a, b) => a.latency - b.latency);
    
    return successful[0]?.url || endpoints[0]; // Fallback to US
};""" ;
    geo:hasRegionalDistribution "3 geographic regions with automatic failover" .

