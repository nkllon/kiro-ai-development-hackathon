geo:Jurisdiction a owl:Class ;
    rdfs:label "Legal Jurisdiction"@en ;
    rdfs:comment "Legal jurisdiction affecting component operation"@en .

# ================================
# DIMENSION 22: TEMPORAL CHARACTERISTICS
# ================================

time:TemporalCharacteristic a owl:Class ;
    rdfs:label "Temporal System Characteristic"@en ;
    rdfs:comment "Time-related aspect of system behavior"@en .

time:ResponseTime a owl:Class ;
    rdfs:subClassOf time:TemporalCharacteristic ;
    rdfs:label "System Response Time"@en .

time:UpTime a owl:Class ;
    rdfs:subClassOf time:TemporalCharacteristic ;
    rdfs:label "System Uptime"@en .

time:DownTime a owl:Class ;
    rdfs:subClassOf time:TemporalCharacteristic ;
    rdfs:label "System Downtime"@en .

time:RecoveryTime a owl:Class ;
    rdfs:subClassOf time:TemporalCharacteristic ;
    rdfs:label "System Recovery Time"@en .

time:MaintenanceWindow a owl:Class ;
    rdfs:subClassOf time:TemporalCharacteristic ;
    rdfs:label "Scheduled Maintenance Window"@en .

# ================================
# OBJECT PROPERTIES (RELATIONSHIPS)
# ================================

# Problem Domain Properties
ws:hasSymptom a owl:ObjectProperty ;
    rdfs:domain ws:Problem ;
    rdfs:range xsd:string ;
    rdfs:label "has observable symptom"@en ;
    rdfs:comment "Observable manifestation of the problem"@en .

ws:hasCause a owl:ObjectProperty ;
    rdfs:domain ws:Problem ;
    rdfs:range infra:Component ;
    rdfs:label "has root cause"@en ;
    rdfs:comment "Primary component causing the problem"@en .

ws:triggersFailure a owl:ObjectProperty ;
    rdfs:domain ws:Problem ;
    rdfs:range ws:Problem ;
    rdfs:label "triggers cascade failure"@en ;
    rdfs:comment "One problem triggering another in cascade sequence"@en ;
    owl:propertyChainAxiom ( ws:hasCause infra:dependsOn ws:affects ) .

ws:affects a owl:ObjectProperty ;
    rdfs:domain infra:Component ;
    rdfs:range ws:Problem ;
    rdfs:label "affects problem"@en .

# Infrastructure Properties
infra:dependsOn a owl:ObjectProperty ;
    rdfs:domain infra:Component ;
    rdfs:range infra:Component ;
    rdfs:label "depends on component"@en ;
    rdfs:comment "Component dependency relationship"@en ;
    a owl:TransitiveProperty .

infra:hosts a owl:ObjectProperty ;
    rdfs:domain infra:Component ;
    rdfs:range infra:Component ;
    rdfs:label "hosts component"@en .

infra:connectsTo a owl:ObjectProperty ;
    rdfs:domain infra:NetworkComponent ;
    rdfs:range infra:NetworkComponent ;
    rdfs:label "connects to network component"@en ;
    a owl:SymmetricProperty .

infra:locatedAt a owl:ObjectProperty ;
    rdfs:domain infra:Component ;
    rdfs:range geo:GeographicLocation ;
    rdfs:label "located at geographic location"@en .

# Solution Properties
exec:solveProblem a owl:ObjectProperty ;
    rdfs:domain exec:Solution ;
    rdfs:range ws:Problem ;
    rdfs:label "solves identified problem"@en ;
    rdfs:comment "Solution addresses specific problem"@en .

exec:requiresComponent a owl:ObjectProperty ;
    rdfs:domain exec:Solution ;
    rdfs:range infra:Component ;
    rdfs:label "requires infrastructure component"@en .

exec:modifiesComponent a owl:ObjectProperty ;
    rdfs:domain exec:Solution ;
    rdfs:range infra:Component ;
    rdfs:label "modifies existing component"@en .

exec:introducesRisk a owl:ObjectProperty ;
    rdfs:domain exec:Solution ;
    rdfs:range risk:Risk ;
    rdfs:label "introduces implementation risk"@en .

exec:mitigatesRisk a owl:ObjectProperty ;
    rdfs:domain exec:Solution ;
    rdfs:range risk:Risk ;
    rdfs:label "mitigates existing risk"@en .

# Risk Properties
risk:hasLikelihood a owl:DatatypeProperty ;
