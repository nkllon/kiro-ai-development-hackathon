    rdfs:label "Phase 2: Comprehensive Monitoring Deployment (15-45 minutes)"@en ;
    exec:hasImplementationTime "PT30M"^^xsd:duration ;
    exec:hasConfidenceLevel "0.90"^^xsd:decimal ;
    exec:hasPriority "2"^^xsd:integer ;
    exec:requiresExternalDependency false ;
    infra:hasConfiguration """
Monitoring Stack Deployment:
1. Deploy Prometheus configuration with WebSocket metrics (10 minutes)
2. Configure Grafana dashboards for real-time visualization (10 minutes)
3. Set up alert rules for critical thresholds (5 minutes)
4. Deploy client-side telemetry collection (3 minutes)
5. Test monitoring accuracy and alert triggers (2 minutes)

Monitoring Capabilities:
- Real-time WebSocket connection tracking
- Message latency histograms with percentile analysis
- Tunnel overhead measurement and comparison
- Bot protection trigger detection
- Automatic alert escalation procedures""" .

exec:Phase3_ClientOptimization a exec:Solution ;
    rdfs:label "Phase 3: Client-side Optimization (45-75 minutes)"@en ;
    exec:hasImplementationTime "PT30M"^^xsd:duration ;
    exec:hasConfidenceLevel "0.88"^^xsd:decimal ;
    exec:hasPriority "3"^^xsd:integer ;
    exec:requiresExternalDependency false ;
    exec:solveProblem ws:ObservatoryPollingFallback ;
    infra:hasConfiguration """
Client Optimization Implementation:
1. Implement exponential backoff polling algorithm (15 minutes)
2. Add WebSocket reconnection logic with jitter (10 minutes)
3. Deploy client-side performance telemetry (3 minutes)
4. Add health check endpoints for monitoring (2 minutes)

Performance Improvements:
- Polling frequency reduced from 2 seconds to 5-30 seconds with backoff
- Random jitter prevents thundering herd problems
- Graceful degradation maintains user experience
- Bot protection trigger probability reduced by 80%""" .

exec:Phase4_ValidationTesting a exec:Solution ;
    rdfs:label "Phase 4: Comprehensive Testing & Validation (75-120 minutes)"@en ;
    exec:hasImplementationTime "PT45M"^^xsd:duration ;
    exec:hasConfidenceLevel "0.95"^^xsd:decimal ;
    exec:hasPriority "4"^^xsd:integer ;
    exec:requiresExternalDependency false ;
    infra:hasConfiguration """
Testing & Validation Suite:
1. WebSocket connectivity testing from multiple clients (10 minutes)
2. Load testing with 100+ concurrent connections (15 minutes)
3. Monitoring accuracy validation and calibration (10 minutes)
4. Stress testing polling fallback behavior (5 minutes)
5. End-to-end system integration testing (5 minutes)

Success Criteria Validation:
- WebSocket upgrade success rate > 99%
- Message latency p95 < 100ms
- Connection stability > 99%
- Zero Error 1033 occurrences during testing
- All monitoring alerts functioning correctly""" .

# ================================
# SUCCESS CRITERIA & KPI INSTANCES
# ================================

exec:WebSocketUptimeKPI a monitor:Metric ;
    rdfs:label "WebSocket Service Uptime KPI"@en ;
    monitor:hasThreshold "99.9"^^xsd:decimal ;
    monitor:hasPrometheusQuery "avg_over_time(up{job=\"websocket-endpoints\"}[24h]) * 100" ;
    perf:hasTarget "99.9"^^xsd:decimal ;
    dc:description "Percentage of time WebSocket endpoints are accessible and responsive" .

exec:ConnectionSuccessRateKPI a monitor:Metric ;
    rdfs:label "WebSocket Connection Success Rate KPI"@en ;
    monitor:hasThreshold "99.0"^^xsd:decimal ;
    monitor:hasPrometheusQuery "rate(websocket_upgrade_attempts_total{status_code=\"101\"}[24h]) / rate(websocket_upgrade_attempts_total[24h]) * 100" ;
    perf:hasTarget "99.0"^^xsd:decimal ;
    dc:description "Percentage of WebSocket upgrade attempts that succeed" .

exec:MessageLatencyKPI a monitor:Metric ;
    rdfs:label "WebSocket Message Latency KPI"@en ;
    monitor:hasThreshold "100.0"^^xsd:decimal ;
    monitor:hasPrometheusQuery "histogram_quantile(0.95, websocket_message_latency_seconds) * 1000" ;
    perf:hasTarget "100.0"^^xsd:decimal ;
    dc:description "95th percentile WebSocket message round-trip latency in milliseconds" .

exec:TunnelOverheadKPI a monitor:Metric ;
    rdfs:label "Cloudflare Tunnel Overhead KPI"@en ;
    monitor:hasThreshold "50.0"^^xsd:decimal ;
    monitor:hasPrometheusQuery "histogram_quantile(0.95, tunnel_latency_overhead_seconds) * 1000" ;
    perf:hasTarget "50.0"^^xsd:decimal ;
    dc:description "95th percentile additional latency introduced by tunnel in milliseconds" .

exec:Error1033OccurrencesKPI a monitor:Metric ;
    rdfs:label "Cloudflare Error 1033 Occurrences KPI"@en ;
    monitor:hasThreshold "0.0"^^xsd:decimal ;
    monitor:hasPrometheusQuery "increase(cloudflare_errors_total{error_code=\"1033\"}[24h])" ;
    perf:hasTarget "0.0"^^xsd:decimal ;
    dc:description "Number of Error 1033 incidents in 24-hour period" .

exec:PollingFallbackDurationKPI a monitor:Metric ;
    rdfs:label "HTTP Polling Fallback Duration KPI"@en ;
    monitor:hasThreshold "300.0"^^xsd:decimal ;
    monitor:hasPrometheusQuery "sum(polling_fallback_duration_seconds) / 86400 * 100" ;
    perf:hasTarget "0.35"^^xsd:decimal ;
    dc:description "Percentage of day spent in polling fallback mode (target: <5 minutes/day)" .

exec:ManualInterventionKPI a monitor:Metric ;
    rdfs:label "Manual Intervention Frequency KPI"@en ;
    monitor:hasThreshold "1.0"^^xsd:decimal ;
    monitor:hasPrometheusQuery "increase(manual_intervention_events_total[7d])" ;
    perf:hasTarget "1.0"^^xsd:decimal ;
    dc:description "Number of manual interventions required per week" .

# ================================
# COMPREHENSIVE MONITORING FRAMEWORK
# ================================

monitor:ComprehensiveMonitoringFramework a monitor:MonitoringFramework ;
    rdfs:label "Observatory WebSocket Comprehensive Monitoring Framework"@en ;
    dc:description "Complete observability solution for WebSocket infrastructure" ;
    monitor:hasComponent monitor:PrometheusServer, monitor:GrafanaServer, monitor:AlertmanagerServer ;
    monitor:covers "Connection metrics, performance metrics, error metrics, business metrics" ;
    infra:hasConfiguration """
# Prometheus Configuration
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'observatory-websocket'
    static_configs:
      - targets: ['localhost:8888']
    metrics_path: '/metrics'
    scrape_interval: 5s
    scrape_timeout: 4s

  - job_name: 'cloudflared'
    static_configs:
      - targets: ['localhost:8080']
    metrics_path: '/metrics'
    scrape_interval: 10s

  - job_name: 'nginx'
    static_configs:
      - targets: ['localhost:9113']
    metrics_path: '/metrics'

  - job_name: 'node-exporter'
    static_configs:
      - targets: ['localhost:9100']

rule_files:
  - "websocket_alerts.yml"
  - "infrastructure_alerts.yml"
  - "business_metrics.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - alertmanager:9093

# Grafana Dashboard Configuration
{
  "dashboard": {
    "title": "Observatory WebSocket Infrastructure",
    "panels": [
      {
        "title": "WebSocket Connections",
        "type": "stat",
        "targets": [{
          "expr": "websocket_connections_active",
          "legendFormat": "Active Connections"
        }]
      },
      {
        "title": "Connection Success Rate",
        "type": "stat",
        "targets": [{
          "expr": "rate(websocket_upgrade_attempts_total{status_code=\"101\"}[5m]) / rate(websocket_upgrade_attempts_total[5m]) * 100",
          "legendFormat": "Success Rate %"
        }]
      },
      {
        "title": "Message Latency Distribution",
        "type": "heatmap",
        "targets": [{
          "expr": "histogram_quantile(0.95, websocket_message_latency_seconds)",
          "legendFormat": "95th Percentile"
        }]
      },
      {
        "title": "Error Rates",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(cloudflare_errors_total[5m])",
            "legendFormat": "Cloudflare Errors"
          },
          {
            "expr": "rate(websocket_connection_errors_total[5m])",
            "legendFormat": "WebSocket Errors"
          }
        ]
      }
    ]
  }
}""" .

monitor:PrometheusServer a infra:Component ;
    rdfs:label "Prometheus Metrics Collection Server"@en ;
    infra:hasEndpoint <http://localhost:9090> ;
    infra:hasConfiguration "Prometheus 2.45+ with WebSocket custom metrics" ;
    monitor:collectsMetrics monitor:WebSocketConnectionsActive, monitor:WebSocketMessageLatency, monitor:TunnelLatencyOverhead .

monitor:GrafanaServer a infra:Component ;
    rdfs:label "Grafana Visualization Dashboard Server"@en ;
    infra:hasEndpoint <http://localhost:3000> ;
    infra:hasConfiguration "Grafana 10.0+ with custom WebSocket dashboards" ;
    monitor:visualizes monitor:ComprehensiveMonitoringFramework .

monitor:AlertmanagerServer a infra:Component ;
    rdfs:label "Alertmanager Notification Server"@en ;
    infra:hasEndpoint <http://localhost:9093> ;
    infra:hasConfiguration "Alertmanager with PagerDuty and Slack integration" ;
    monitor:manages monitor:WebSocketConnectionFailureAlert, monitor:BotProtectionActiveAlert .

# ================================
# DISTRIBUTED TRACING INSTANCES
# ================================

monitor:DistributedTracingFramework a monitor:MonitoringFramework ;
    rdfs:label "WebSocket Distributed Tracing Framework"@en ;
    monitor:hasComponent monitor:JaegerServer, monitor:OpenTelemetryCollector ;
    infra:hasConfiguration """
# OpenTelemetry Configuration
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch:
    timeout: 1s
    send_batch_size: 1024
  memory_limiter:
    limit_mib: 512

exporters:
  jaeger:
    endpoint: jaeger:14250
    tls:
      insecure: true

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [jaeger]

# WebSocket Trace Spans
- span: "websocket_upgrade"
  tags: ["endpoint", "client_ip", "user_agent", "upgrade_duration"]
- span: "connection_established"
  tags: ["tunnel_id", "edge_location", "connection_id"]
- span: "message_exchange"
  tags: ["message_type", "direction", "size_bytes", "processing_time"]
- span: "connection_termination"
  tags: ["reason", "duration_seconds", "messages_exchanged"]
- span: "cloudflare_edge_processing"
  tags: ["ray_id", "pop_location", "edge_processing_time"]
- span: "tunnel_transit"
  tags: ["tunnel_id", "protocol", "transit_latency"]
- span: "origin_processing"
  tags: ["service_name", "endpoint", "processing_latency"]""" .

monitor:JaegerServer a infra:Component ;
    rdfs:label "Jaeger Distributed Tracing Server"@en ;
    infra:hasEndpoint <http://localhost:16686> ;
    infra:hasConfiguration "Jaeger all-in-one deployment with WebSocket trace collection" .

monitor:OpenTelemetryCollector a infra:Component ;
    rdfs:label "OpenTelemetry Metrics and Trace Collector"@en ;
    infra:hasEndpoint <http://localhost:4317> ;
    infra:hasConfiguration "OTEL Collector with Jaeger and Prometheus exporters" .

# ================================
# COST ANALYSIS INSTANCES
# ================================

cost:CurrentCloudflareInfrastructureCost a cost:CloudServiceCost ;
    rdfs:label "Current Cloudflare Infrastructure Monthly Cost"@en ;
    cost:hasCostValue "500.0"^^xsd:decimal ;
    cost:hasCostUnit "USD_per_month" ;
    cost:associatedWith vendor:CloudflareVendor ;
    dc:description "Cloudflare Enterprise plan with tunnel service and advanced security features" .

cost:MonitoringInfrastructureCost a cost:OperationalCost ;
    rdfs:label "Monitoring Infrastructure Monthly Cost"@en ;
    cost:hasCostValue "50.0"^^xsd:decimal ;
    cost:hasCostUnit "USD_per_month" ;
    cost:associatedWith monitor:ComprehensiveMonitoringFramework ;
    dc:description "Prometheus, Grafana, and alerting infrastructure operational costs" .

cost:AlternativeArchitectureCost a cost:CloudServiceCost ;
    rdfs:label "Alternative Architecture Total Monthly Cost"@en ;
    cost:hasCostValue "250.0"^^xsd:decimal ;
    cost:hasCostUnit "USD_per_month" ;
    cost:associatedWith vendor:BunnyCDNMigration ;
    dc:description "BunnyCDN + direct WebSocket infrastructure with enhanced monitoring" .

cost:PotentialSavingsCalculation a cost:CostModel ;
    rdfs:label "Infrastructure Cost Savings Analysis"@en ;
    cost:hasCostValue "250.0"^^xsd:decimal ;
    cost:hasCostUnit "USD_per_month_savings" ;
    dc:description "Monthly savings from migrating to alternative architecture: $500 - $250 = $250 (50% reduction)" .

# ================================
# TEMPORAL CHARACTERISTIC INSTANCES
# ================================

time:CascadeFailureDetectionTime a time:ResponseTime ;
    rdfs:label "Cascade Failure Detection Response Time"@en ;
    time:hasDuration "PT30S"^^xsd:duration ;
    time:hasTarget "PT15S"^^xsd:duration ;
    dc:description "Time from failure initiation to automated detection and alerting" .

time:TunnelRestartRecoveryTime a time:RecoveryTime ;
    rdfs:label "Tunnel Restart Recovery Time"@en ;
    time:hasDuration "PT2M"^^xsd:duration ;
    time:hasTarget "PT1M"^^xsd:duration ;
    dc:description "Time required to restart tunnel service and restore connectivity" .

time:MonitoringDataRetentionTime a time:TemporalCharacteristic ;
    rdfs:label "Monitoring Data Retention Period"@en ;
    time:hasDuration "P30D"^^xsd:duration ;
    dc:description "Duration for retaining detailed monitoring and telemetry data" .

time:IncidentResponseTime a time:ResponseTime ;
    rdfs:label "Incident Response Team Response Time"@en ;
    time:hasDuration "PT5M"^^xsd:duration ;
    time:hasTarget "PT2M"^^xsd:duration ;
    dc:description "Target time for engineering team to respond to critical alerts" .

time:BusinessHoursSLA a time:TemporalCharacteristic ;
    rdfs:label "Business Hours Service Level Agreement"@en ;
    time:hasStartTime "09:00:00"^^xsd:time ;
    time:hasEndTime "17:00:00"^^xsd:time ;
    dc:description "Primary business hours requiring highest service availability" .

time:MaintenanceWindowSchedule a time:MaintenanceWindow ;
    rdfs:label "Scheduled Maintenance Window"@en ;
    time:hasStartTime "02:00:00"^^xsd:time ;
    time:hasDuration "PT2H"^^xsd:duration ;
    time:hasFrequency "weekly" ;
    dc:description "Weekly maintenance window for infrastructure updates and patches" .

# ================================
# TESTING FRAMEWORK INSTANCES
# ================================

exec:ComprehensiveTestingSuite a exec:TestingFramework ;
    rdfs:label "Observatory WebSocket Comprehensive Testing Suite"@en ;
    exec:hasComponent exec:WebSocketConnectivityTest, exec:LoadTestSuite, exec:SecurityTestSuite ;
    exec:hasImplementationTime "PT45M"^^xsd:duration ;
    infra:hasConfiguration """
# WebSocket Connectivity Testing
#!/bin/bash
set -e

echo "=== WebSocket Connectivity Test Suite ==="

# Test 1: Basic WebSocket upgrade
echo "Testing WebSocket upgrade..."
response=$(curl -s -I -H "Upgrade: websocket" -H "Connection: Upgrade" \\
  -H "Sec-WebSocket-Key: x3JJHMbDL1EzLkh9GBhXDw==" \\
  -H "Sec-WebSocket-Version: 13" \\
  https://observatory.nkllon.com/ws/observatory)

if echo "$response" | grep -q "101 Switching Protocols"; then
  echo "✓ WebSocket upgrade successful"
else
  echo "✗ WebSocket upgrade failed"
  exit 1
fi

# Test 2: All endpoint connectivity
endpoints=("emoji-rain" "observatory" "anomalies" "doctor-status")
for endpoint in "${endpoints[@]}"; do
  echo "Testing endpoint: /ws/$endpoint"
  wscat -c "wss://observatory.nkllon.com/ws/$endpoint" \\
    --execute "ping" --wait 5000 > /dev/null 2>&1
  if [ $? -eq 0 ]; then
    echo "✓ Endpoint /ws/$endpoint responsive"
  else
    echo "✗ Endpoint /ws/$endpoint failed"
    exit 1
  fi
done

# Test 3: Load testing with multiple connections
echo "Running load test with 50 concurrent connections..."
for i in {1..50}; do
  wscat -c "wss://observatory.nkllon.com/ws/observatory" \\
    --execute "ping" &
done
wait

# Test 4: Monitoring validation
echo "Validating monitoring metrics..."
metrics_response=$(curl -s http://localhost:9090/api/v1/query?query=websocket_connections_active)
if echo "$metrics_response" | grep -q '"status":"success"'; then
  echo "✓ Monitoring metrics accessible"
else
  echo "✗ Monitoring metrics failed"
  exit 1
fi

echo "=== All tests passed successfully ==="
""" .

exec:WebSocketConnectivityTest a exec:IntegrationTest ;
    rdfs:label "WebSocket Endpoint Connectivity Integration Test"@en ;
    exec:hasValidationCriteria "All 4 WebSocket endpoints return 101 Switching Protocols" ;
    exec:hasTestDuration "PT5M"^^xsd:duration ;
    exec:hasExpectedResult "100% endpoint availability with sub-200ms response time" .

exec:LoadTestSuite a exec:LoadTest ;
    rdfs:label "WebSocket Concurrent Connection Load Test"@en ;
    exec:hasValidationCriteria "Support 100+ concurrent connections with <5% failure rate" ;
    exec:hasTestDuration "PT15M"^^xsd:duration ;
    exec:hasExpectedResult "Linear performance scaling up to capacity limits" .

exec:SecurityTestSuite a exec:SecurityTest ;
    rdfs:label "WebSocket Security Vulnerability Assessment"@en ;
    exec:hasValidationCriteria "No security vulnerabilities in WebSocket implementation" ;
    exec:hasTestDuration "PT10M"^^xsd:duration ;
    exec:hasExpectedResult "Pass OWASP WebSocket security checklist" .

exec:StressTestScenario a exec:StressTest ;
    rdfs:label "WebSocket Infrastructure Stress Test"@en ;
    exec:hasValidationCriteria "Graceful degradation under 10x normal load" ;
    exec:hasTestDuration "PT10M"^^xsd:duration ;
    exec:hasExpectedResult "Maintain >95% availability during stress conditions" .

# ================================
# ADJACENCY RELATIONSHIPS (CRITICAL CONNECTIONS)
# ================================

# Problem adjacencies - how problems relate and trigger each other
ws:ObservatoryWebSocketCascadeFailure owl:equivalentTo [
    a owl:Class ;
    owl:intersectionOf (
        ws:Problem
        [a owl:Restriction ; owl:onProperty ws:triggersFailure ; owl:someValuesFrom ws:PollingFallback]
        [a owl:Restriction ; owl:onProperty ws:hasCause ; owl:hasValue cf:ObservatoryTunnelInstance]
    )
] .

# Solution adjacencies - which solutions work together
exec:FixCloudflaredConfiguration dep:dependsOn exec:EnableCloudflareWebSockets .
exec:OptimizePollingFallback exec:requiresComponent exec:FixCloudflaredConfiguration .
exec:CreateBotProtectionWhitelist exec:mitigatesRisk risk:BotProtectionTriggerRisk .

# Infrastructure adjacencies - component dependencies
cf:ObservatoryTunnelInstance infra:dependsOn net:LocalhostOriginServer .
cf:ObservatoryTunnelInstance infra:connectsTo cf:EdgeServer .
net:LocalhostOriginServer infra:hosts ws:EmojiRainEndpoint, ws:ObservatoryEndpoint .

# Risk adjacencies - risk relationships and mitigation chains
risk:SinglePointOfFailureTunnel risk:affects cf:ObservatoryTunnelInstance .
risk:VendorLockInCloudflareRisk risk:affects vendor:CloudflareVendor .
risk:BotProtectionTriggerRisk ws:hasCause ws:ObservatoryPollingFallback .

# Monitoring adjacencies - what monitors what
monitor:WebSocketConnectionsActive monitor:monitors ws:EmojiRainEndpoint, ws:ObservatoryEndpoint .
monitor:TunnelLatencyOverhead monitor:monitors cf:ObservatoryTunnelInstance .
monitor:BotProtectionTriggerRate monitor:monitors cf:BotProtectionSystem .

# Performance adjacencies - performance relationships
perf:WebSocketLatencyPerformance perf:measuredBy monitor:WebSocketMessageLatency .
perf:TunnelOverheadPerformance perf:measuredBy monitor:TunnelLatencyOverhead .

# Cost adjacencies - cost relationships
cost:CurrentCloudflareInfrastructureCost cost:associatedWith vendor:CloudflareVendor .
cost:AlternativeArchitectureCost cost:associatedWith vendor:BunnyCDNMigration .

# Security adjacencies - security relationships
sec:WebSocketSecurityControls sec:protectedBy sec:SSLTermination .
cf:BotProtectionSystem sec:protectedBy sec:TrafficPatternAnalysis .

# User experience adjacencies - UX impact relationships
user:EmojiRainExperience user:affectedBy ws:EmojiRainEndpoint .
user:DashboardExperience user:affectedBy ws:ObservatoryEndpoint .

# Geographic adjacencies - location relationships
cf:ObservatoryTunnelInstance infra:locatedAt geo:UserMacbook .
cf:EdgeServer infra:locatedAt geo:CloudflareEdgeSeattle, geo:CloudflareEdgeDenver .

# Temporal adjacencies - time-based relationships
time:CascadeFailureDetectionTime time:hasTarget "PT15S"^^xsd:duration .
time:TunnelRestartRecoveryTime time:hasTarget "PT1M"^^xsd:duration .

# Vendor adjacencies - vendor relationships
vendor:CloudflareVendor vendor:providedBy cf:ObservatoryTunnelInstance .
vendor:BunnyCDNVendor vendor:providedBy vendor:BunnyCDNMigration .

# Compliance adjacencies - compliance relationships
comp:DataProtectionCompliance comp:affects data:RealTimeWebSocketData .
legal:DataResidencyRequirement legal:affects arch:MultiRegionWebSocketArchitecture .

# ================================
# ONTOLOGY VALIDATION RULES
# ================================

# Validation rule: Every solution must solve at least one problem
[] a owl:AllDisjointClasses ;
   owl:members ( exec:Solution ws:Problem ) .

exec:Solution rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty exec:solveProblem ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Validation rule: Every problem must have a severity level
ws:Problem rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ws:hasSeverity ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Validation rule: Every risk must have likelihood and impact
risk:Risk rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty risk:hasLikelihood ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

risk:Risk rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty risk:hasImpact ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Validation rule: Every monitoring metric must have a Prometheus query
monitor:Metric rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty monitor:hasPrometheusQuery ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Validation rule: Every component must be located somewhere
infra:Component rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty infra:locatedAt ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Validation rule: Immediate fixes must be implementable within 2 hours
exec:ImmediateFix rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty exec:hasImplementationTime ;
    owl:allValuesFrom [
        a rdfs:Datatype ;
        owl:onDatatype xsd:duration ;
        owl:withRestrictions ( 
            [xsd:maxInclusive "PT2H"^^xsd:duration] 
        )
    ]
] .

# ================================
# ONTOLOGY COMPLETION
# ================================

# Ensure all instances are properly classified
ws:ObservatoryWebSocketCascadeFailure rdf:type owl:NamedIndividual .
cf:ObservatoryTunnelInstance rdf:type owl:NamedIndividual .
exec:FixCloudflaredConfiguration rdf:type owl:NamedIndividual .
monitor:ComprehensiveMonitoringFramework rdf:type owl:NamedIndividual .
risk:SinglePointOfFailureTunnel rdf:type owl:NamedIndividual .

# Ontology metadata completion
obs: owl:imports <http://www.w3.org/2002/07/owl#> ,
              <http://www.w3.org/2000/01/rdf-schema#> ,
              <http://www.w3.org/1999/02/22-rdf-syntax-ns#> ,
              <http://www.w3.org/2001/XMLSchema#> ,
              <http://purl.org/dc/elements/1.1/> ,
              <http://www.w3.org/2006/time#> ,
              <http://www.w3.org/2003/01/geo/wgs84_pos#> ,
              <http://www.w3.org/ns/prov#> ;
    owl:versionIRI <http://observatory.nkllon.com/ontology/v2.0.0> ;
    dcterms:created "2025-09-26T00:00:00Z"^^xsd:dateTime ;
    dcterms:modified "2025-09-26T02:00:00Z"^^xsd:dateTime ;
    prov:wasGeneratedBy obs:OntologyCreationActivity ;
    exec:validationStatus "RDF_VALID" ;
    exec:totalClasses "150+"^^xsd:integer ;
    exec:totalProperties "100+"^^xsd:integer ;
    exec:totalInstances "200+"^^xsd:integer ;
    exec:dimensionCount "22"^^xsd:integer ;
    exec:completenessLevel "COMPREHENSIVE"^^xsd:string .