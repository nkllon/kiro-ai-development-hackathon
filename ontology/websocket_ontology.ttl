# ================================
# PROBLEM INSTANCES (OBSERVABLE EVIDENCE)
# ================================

# Root cascade failure instance
ws:ObservatoryWebSocketCascadeFailure a ws:CascadeFailure ;
    rdfs:label "Observatory WebSocket Infrastructure Cascade Failure"@en ;
    dc:description "Critical cascade failure affecting Observatory WebSocket infrastructure causing service outages" ;
    ws:hasSymptom "HTTP/2 404 responses on WebSocket upgrade requests" ;
    ws:hasSeverity "critical" ;
    ws:hasCause cf:ObservatoryTunnelInstance ;
    ws:triggersFailure ws:ObservatoryPollingFallback ;
    prov:wasObservedAt "2025-09-26T00:00:00Z"^^xsd:dateTime ;
    risk:hasLikelihood "0.85"^^xsd:decimal ;
    risk:hasImpact "high" .

# Specific protocol downgrade problem
ws:WebSocketProtocolDowngrade a ws:ProtocolDowngrade ;
    rdfs:label "WebSocket to HTTP/2 Protocol Downgrade"@en ;
    ws:hasSymptom "WebSocket Upgrade header ignored, connection downgraded to HTTP/2" ;
    ws:hasSeverity "critical" ;
    ws:hasCause cf:ObservatoryTunnelInstance ;
    perf:hasBaseline "0.0"^^xsd:decimal ;
    perf:hasTarget "99.9"^^xsd:decimal .

# Aggressive polling fallback
ws:ObservatoryPollingFallback a ws:PollingFallback ;
    rdfs:label "Observatory Aggressive HTTP Polling Fallback"@en ;
    ws:hasSymptom "6-10 HTTP requests every 2 seconds across multiple endpoints" ;
    ws:hasSeverity "high" ;
    ws:triggersFailure ws:BotProtectionActivation ;
    perf:hasBaseline "30.0"^^xsd:decimal ;
    perf:hasTarget "0.5"^^xsd:decimal .

# Bot protection cascade trigger
ws:BotProtectionActivation a ws:BotProtectionTrigger ;
    rdfs:label "Cloudflare Bot Protection Cascade Activation"@en ;
    ws:hasSymptom "Error 1033 - Origin unreachable, manual tunnel restart required" ;
    ws:hasSeverity "critical" ;
    ws:hasCause cf:BotProtectionSystem ;
    time:hasFrequency "intermittent_based_on_websocket_usage" .

# ================================
# INFRASTRUCTURE COMPONENT INSTANCES
# ================================

# Primary Cloudflare tunnel instance
cf:ObservatoryTunnelInstance a cf:Tunnel ;
    rdfs:label "Observatory Production Cloudflare Tunnel"@en ;
    infra:hasConfiguration """tunnel: d1e53e43-033f-4994-8f46-c83962ae3785
credentials-file: /Users/lou/.cloudflared/d1e53e43-033f-4994-8f46-c83962ae3785.json
ingress:
  - hostname: observatory.nkllon.com
    service: http://localhost:8888
    originRequest:
      httpHostHeader: localhost:8888
  - service: http_status:404""" ;
    infra:hasEndpoint <https://observatory.nkllon.com> ;
    infra:hasVersion "cloudflared_2025.x" ;
    infra:locatedAt geo:UserMacbook ;
    vendor:providedBy vendor:CloudflareVendor ;
    dep:dependsOn net:LocalhostOriginServer ;
    risk:affects risk:SinglePointOfFailureTunnel .

# Cloudflare dashboard configuration
cf:DashboardWebSocketSettings a cf:Dashboard ;
    rdfs:label "Cloudflare Dashboard WebSocket Configuration"@en ;
    infra:hasConfiguration "Network > WebSockets > Currently Disabled" ;
    vendor:providedBy vendor:CloudflareVendor ;
    exec:modifiesComponent cf:ObservatoryTunnelInstance .

# Bot protection system
cf:BotProtectionSystem a cf:BotProtection ;
    rdfs:label "Cloudflare Bot Detection and Mitigation System"@en ;
    infra:hasConfiguration "Default bot protection rules with aggressive traffic pattern detection" ;
    sec:hasSecurityLevel "high" ;
    vendor:providedBy vendor:CloudflareVendor ;
    sec:protectedBy sec:TrafficPatternAnalysis .

# WebSocket endpoint instances
ws:EmojiRainEndpoint a ws:Endpoint ;
    rdfs:label "Emoji Rain Real-time WebSocket Endpoint"@en ;
    infra:hasEndpoint <ws://localhost:8888/ws/emoji-rain> ;
    infra:locatedAt geo:UserMacbook ;
    dep:dependsOn net:LocalhostOriginServer ;
    user:affects user:EmojiRainExperience .

ws:ObservatoryEndpoint a ws:Endpoint ;
    rdfs:label "Observatory Dashboard WebSocket Endpoint"@en ;
    infra:hasEndpoint <ws://localhost:8888/ws/observatory> ;
    infra:locatedAt geo:UserMacbook ;
    dep:dependsOn net:LocalhostOriginServer ;
    user:affects user:DashboardExperience .

ws:AnomaliesEndpoint a ws:Endpoint ;
    rdfs:label "Anomaly Detection WebSocket Endpoint"@en ;
    infra:hasEndpoint <ws://localhost:8888/ws/anomalies> ;
    infra:locatedAt geo:UserMacbook ;
    dep:dependsOn net:LocalhostOriginServer ;
    user:affects user:AnomalyMonitoringExperience .

ws:DoctorStatusEndpoint a ws:Endpoint ;
    rdfs:label "System Health Doctor WebSocket Endpoint"@en ;
    infra:hasEndpoint <ws://localhost:8888/ws/doctor-status> ;
    infra:locatedAt geo:UserMacbook ;
    dep:dependsOn net:LocalhostOriginServer ;
    user:affects user:SystemHealthExperience .

# Origin server
net:LocalhostOriginServer a net:OriginServer ;
    rdfs:label "Observatory FastAPI Origin Server"@en ;
    infra:hasEndpoint <http://localhost:8888> ;
    infra:hasConfiguration "FastAPI with WebSocket support on port 8888" ;
    infra:locatedAt geo:UserMacbook ;
    infra:hosts ws:EmojiRainEndpoint, ws:ObservatoryEndpoint, ws:AnomaliesEndpoint, ws:DoctorStatusEndpoint .

# ================================
# IMMEDIATE SOLUTION INSTANCES
# ================================

# Fix 1: Tunnel configuration correction
exec:FixCloudflaredConfiguration a exec:ImmediateFix ;
    rdfs:label "Correct Cloudflared WebSocket Configuration"@en ;
    dc:description "Update cloudflared config.yml with proper WebSocket proxy settings" ;
    exec:solveProblem ws:WebSocketProtocolDowngrade ;
    exec:hasImplementationTime "PT15M"^^xsd:duration ;
    exec:hasConfidenceLevel "0.95"^^xsd:decimal ;
    exec:hasPriority "1"^^xsd:integer ;
    exec:modifiesFile "~/.cloudflared/config.yml" ;
    exec:hasValidationCommand "cloudflared tunnel ingress validate" ;
    exec:requiresExternalDependency false ;
    exec:hasCommand "Edit config file and restart cloudflared service" ;
    infra:hasConfiguration """tunnel: d1e53e43-033f-4994-8f46-c83962ae3785
credentials-file: /Users/lou/.cloudflared/d1e53e43-033f-4994-8f46-c83962ae3785.json
ingress:
  - hostname: observatory.nkllon.com
    service: http://localhost:8888
    originRequest:
      httpHostHeader: localhost:8888
      connectTimeout: 30s
      disableChunkedEncoding: true
      noTLSVerify: true
  - service: http_status:404""" ;
    exec:mitigatesRisk risk:WebSocketUpgradeFailureRisk .

# Fix 2: Enable WebSockets in dashboard
exec:EnableCloudflareWebSockets a exec:ImmediateFix ;
    rdfs:label "Enable WebSocket Support in Cloudflare Dashboard"@en ;
    exec:solveProblem ws:WebSocketProtocolDowngrade ;
    exec:hasImplementationTime "PT5M"^^xsd:duration ;
    exec:hasConfidenceLevel "0.99"^^xsd:decimal ;
    exec:hasPriority "2"^^xsd:integer ;
    exec:hasCommand "Navigate to Cloudflare Dashboard > Network > WebSockets > Toggle On" ;
    exec:requiresExternalDependency true ;
    exec:modifiesComponent cf:DashboardWebSocketSettings ;
    exec:mitigatesRisk risk:WebSocketUpgradeFailureRisk .

# Fix 3: Optimize polling behavior
exec:OptimizePollingFallback a exec:ImmediateFix ;
    rdfs:label "Implement Exponential Backoff HTTP Polling"@en ;
    exec:solveProblem ws:ObservatoryPollingFallback ;
    exec:hasImplementationTime "PT30M"^^xsd:duration ;
    exec:hasConfidenceLevel "0.90"^^xsd:decimal ;
    exec:hasPriority "3"^^xsd:integer ;
    exec:modifiesFile "frontend/js/websocket-client.js" ;
    exec:requiresExternalDependency false ;
    infra:hasConfiguration """// Exponential backoff implementation
let pollInterval = 5000; // Start with 5 seconds
const maxInterval = 30000; // Maximum 30 seconds
const backoffMultiplier = 1.5;
const jitterMax = 1000; // Random jitter up to 1 second

function pollWithBackoff() {
  fetch('/api/endpoint')
    .then(response => {
      if (response.ok) {
        pollInterval = 5000; // Reset on success
      } else {
        pollInterval = Math.min(pollInterval * backoffMultiplier, maxInterval);
      }
    })
    .catch(() => {
      pollInterval = Math.min(pollInterval * 2, maxInterval);
    });
  
  const jitter = Math.random() * jitterMax;
  setTimeout(pollWithBackoff, pollInterval + jitter);
}""" ;
    exec:mitigatesRisk risk:BotProtectionTriggerRisk .

# Fix 4: Create bot protection whitelist
exec:CreateBotProtectionWhitelist a exec:ImmediateFix ;
    rdfs:label "Configure Bot Protection Origin IP Whitelist"@en ;
    exec:solveProblem ws:BotProtectionActivation ;
    exec:hasImplementationTime "PT10M"^^xsd:duration ;
    exec:hasConfidenceLevel "0.85"^^xsd:decimal ;
    exec:hasPriority "4"^^xsd:integer ;
    exec:hasCommand "Create Cloudflare firewall rule: (ip.src eq ORIGIN_IP) then allow" ;
    exec:requiresExternalDependency true ;
    exec:modifiesComponent cf:BotProtectionSystem ;
    exec:mitigatesRisk risk:BotProtectionTriggerRisk .

# Fix 5: Service restart procedure
exec:RestartCloudflaredService a exec:ImmediateFix ;
    rdfs:label "Restart Cloudflared Service with New Configuration"@en ;
    exec:solveProblem ws:ObservatoryWebSocketCascadeFailure ;
    exec:hasImplementationTime "PT2M"^^xsd:duration ;
    exec:hasConfidenceLevel "0.99"^^xsd:decimal ;
    exec:hasPriority "5"^^xsd:integer ;
    exec:hasCommand "sudo systemctl restart cloudflared" ;
    exec:hasValidationCommand "sudo systemctl status cloudflared && curl -I https://observatory.nkllon.com" ;
    exec:requiresExternalDependency false ;
    exec:modifiesComponent cf:ObservatoryTunnelInstance .

# ================================
# COMPREHENSIVE MONITORING INSTANCES
# ================================

# Connection monitoring metrics
monitor:WebSocketConnectionsActive a monitor:ConnectionMetric ;
    rdfs:label "Active WebSocket Connections Gauge"@en ;
    monitor:hasMetricType "gauge" ;
    monitor:hasPrometheusQuery "websocket_connections_active" ;
    monitor:monitors ws:EmojiRainEndpoint, ws:ObservatoryEndpoint, ws:AnomaliesEndpoint, ws:DoctorStatusEndpoint ;
    perf:hasTarget "100.0"^^xsd:decimal .

monitor:WebSocketUpgradeSuccessRate a monitor:ConnectionMetric ;
    rdfs:label "WebSocket Upgrade Success Rate Percentage"@en ;
    monitor:hasMetricType "counter" ;
    monitor:hasPrometheusQuery "rate(websocket_upgrade_attempts_total{status_code=\"101\"}[5m]) / rate(websocket_upgrade_attempts_total[5m]) * 100" ;
    monitor:monitors cf:ObservatoryTunnelInstance ;
    perf:hasTarget "99.9"^^xsd:decimal .

monitor:WebSocketConnectionDuration a monitor:ConnectionMetric ;
    rdfs:label "WebSocket Connection Lifetime Duration"@en ;
    monitor:hasMetricType "histogram" ;
    monitor:hasPrometheusQuery "histogram_quantile(0.95, websocket_connection_duration_seconds)" ;
    monitor:monitors ws:EmojiRainEndpoint, ws:ObservatoryEndpoint ;
    perf:hasTarget "3600.0"^^xsd:decimal .

# Performance monitoring metrics
monitor:WebSocketMessageLatency a monitor:PerformanceMetric ;
    rdfs:label "WebSocket Message Round-trip Latency"@en ;
    monitor:hasMetricType "histogram" ;
    monitor:hasPrometheusQuery "histogram_quantile(0.95, websocket_message_latency_seconds{message_type=\"ping_pong\"})" ;
    monitor:monitors ws:EmojiRainEndpoint, ws:ObservatoryEndpoint ;
    perf:hasTarget "0.1"^^xsd:decimal .

monitor:TunnelLatencyOverhead a monitor:PerformanceMetric ;
    rdfs:label "Cloudflare Tunnel Latency Overhead"@en ;
    monitor:hasMetricType "histogram" ;
    monitor:hasPrometheusQuery "histogram_quantile(0.95, tunnel_latency_overhead_seconds)" ;
    monitor:monitors cf:ObservatoryTunnelInstance ;
    perf:hasTarget "0.05"^^xsd:decimal .

monitor:ThroughputMetric a monitor:PerformanceMetric ;
    rdfs:label "WebSocket Message Throughput Rate"@en ;
    monitor:hasMetricType "counter" ;
    monitor:hasPrometheusQuery "rate(websocket_messages_total[5m])" ;
    monitor:monitors ws:EmojiRainEndpoint ;
    perf:hasTarget "1000.0"^^xsd:decimal .

# Error monitoring metrics
monitor:PollingFallbackFrequency a monitor:ErrorMetric ;
    rdfs:label "HTTP Polling Fallback Activation Rate"@en ;
    monitor:hasMetricType "counter" ;
    monitor:hasPrometheusQuery "rate(polling_fallback_activations_total[5m])" ;
    monitor:monitors ws:ObservatoryPollingFallback ;
    perf:hasTarget "0.0"^^xsd:decimal .

monitor:CloudflareErrorRate a monitor:ErrorMetric ;
    rdfs:label "Cloudflare Infrastructure Error Rate"@en ;
    monitor:hasMetricType "counter" ;
    monitor:hasPrometheusQuery "rate(cloudflare_errors_total[5m])" ;
    monitor:monitors cf:ObservatoryTunnelInstance ;
    perf:hasTarget "0.001"^^xsd:decimal .

monitor:BotProtectionTriggerRate a monitor:ErrorMetric ;
    rdfs:label "Bot Protection System Trigger Rate"@en ;
    monitor:hasMetricType "counter" ;
    monitor:hasPrometheusQuery "rate(bot_protection_triggers_total[5m])" ;
    monitor:monitors cf:BotProtectionSystem ;
    perf:hasTarget "0.0"^^xsd:decimal .

monitor:Error1033Occurrences a monitor:ErrorMetric ;
    rdfs:label "Cloudflare Error 1033 Occurrence Counter"@en ;
    monitor:hasMetricType "counter" ;
    monitor:hasPrometheusQuery "increase(cloudflare_errors_total{error_code=\"1033\"}[24h])" ;
    monitor:monitors cf:ObservatoryTunnelInstance ;
    perf:hasTarget "0.0"^^xsd:decimal .

# ================================
# MONITORING ALERT INSTANCES
# ================================

monitor:WebSocketConnectionFailureAlert a monitor:Alert ;
    rdfs:label "Critical WebSocket Connection Failure Alert"@en ;
    monitor:hasThreshold "0.1"^^xsd:decimal ;
    monitor:hasAlertSeverity "critical" ;
    monitor:hasPrometheusQuery "rate(websocket_upgrade_attempts_total{status_code!=\"101\"}[5m]) > 0.1" ;
    monitor:triggersAlert monitor:WebSocketUpgradeSuccessRate ;
    ops:hasEscalationProcedure "Immediate engineer notification and tunnel restart procedure" .

monitor:TunnelLatencyHighAlert a monitor:Alert ;
    rdfs:label "High Tunnel Latency Performance Alert"@en ;
    monitor:hasThreshold "0.2"^^xsd:decimal ;
    monitor:hasAlertSeverity "warning" ;
    monitor:hasPrometheusQuery "histogram_quantile(0.95, tunnel_latency_overhead_seconds) > 0.2" ;
    monitor:triggersAlert monitor:TunnelLatencyOverhead .

monitor:PollingFallbackActiveAlert a monitor:Alert ;
    rdfs:label "Polling Fallback Activation Alert"@en ;
    monitor:hasThreshold "0.0"^^xsd:decimal ;
    monitor:hasAlertSeverity "warning" ;
    monitor:hasPrometheusQuery "rate(polling_fallback_activations_total[5m]) > 0" ;
    monitor:triggersAlert monitor:PollingFallbackFrequency .

monitor:BotProtectionActiveAlert a monitor:Alert ;
    rdfs:label "Bot Protection System Activation Alert"@en ;
    monitor:hasThreshold "0.0"^^xsd:decimal ;
    monitor:hasAlertSeverity "critical" ;
    monitor:hasPrometheusQuery "rate(bot_protection_triggers_total[5m]) > 0" ;
    monitor:triggersAlert monitor:BotProtectionTriggerRate .

monitor:ServiceUnavailableAlert a monitor:Alert ;
    rdfs:label "Complete Service Unavailability Alert"@en ;
    monitor:hasThreshold "0.95"^^xsd:decimal ;
    monitor:hasAlertSeverity "critical" ;
    monitor:hasPrometheusQuery "avg_over_time(up{job=\"observatory\"}[5m]) < 0.95" ;
