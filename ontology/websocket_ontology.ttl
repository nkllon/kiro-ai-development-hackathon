vendor:BunnyCDNMigration a exec:AlternativeArchitecture ;
    rdfs:label "BunnyCDN Complete Migration Strategy"@en ;
    exec:solveProblem risk:VendorLockInCloudflareRisk, risk:SinglePointOfFailureTunnel ;
    exec:hasImplementationTime "P90D"^^xsd:duration ;
    exec:hasConfidenceLevel "0.75"^^xsd:decimal ;
    exec:requiresExternalDependency true ;
    vendor:hasVendorName "BunnyCDN" ;
    cost:hasCostValue "200.0"^^xsd:decimal ;
    cost:hasCostUnit "USD_per_month" ;
    perf:hasTarget "40.0"^^xsd:decimal ; # 40ms latency improvement
    infra:hasConfiguration """
# BunnyCDN Pull Zone Configuration
- Origin: https://origin.observatory.nkllon.com
- WebSocket support: Native
- Geographic distribution: Global edge locations
- SSL: Automatic Let's Encrypt
- DDoS protection: Built-in

# Migration Steps:
1. Set up BunnyCDN account and pull zone
2. Configure origin server with direct WebSocket support
3. Update DNS records incrementally
4. Test WebSocket connectivity from all regions
5. Monitor performance metrics during migration
6. Complete DNS cutover
7. Decommission Cloudflare tunnel

# Cost Analysis:
- BunnyCDN: $15/TB bandwidth (vs Cloudflare $200 base)
- Origin server: $50/month VPS
- SSL certificates: $0 (Let's Encrypt)
- Monitoring: $30/month
- Total: ~$200/month (60% savings)""" ;
    vendor:providedBy vendor:BunnyCDNVendor .

vendor:AWSCloudFrontMigration a exec:AlternativeArchitecture ;
    rdfs:label "AWS CloudFront + ALB Migration Strategy"@en ;
    exec:solveProblem risk:VendorLockInCloudflareRisk ;
    exec:hasImplementationTime "P60D"^^xsd:duration ;
    exec:hasConfidenceLevel "0.85"^^xsd:decimal ;
    cost:hasCostValue "250.0"^^xsd:decimal ;
    cost:hasCostUnit "USD_per_month" ;
    vendor:hasVendorName "Amazon Web Services" ;
    infra:hasConfiguration """
# AWS Architecture Components:
- CloudFront: Static content distribution
- Application Load Balancer: WebSocket termination
- EC2 instances: Origin servers (multi-AZ)
- Route53: DNS management with health checks
- Certificate Manager: SSL/TLS certificates
- CloudWatch: Monitoring and alerting

# WebSocket Configuration:
- ALB Target Group: WebSocket-enabled
- Sticky sessions: Source IP-based
- Health checks: WebSocket-aware
- Auto Scaling: Based on connection count

# Migration Benefits:
- Native WebSocket support at load balancer
- Granular cost control
- Integration with AWS ecosystem
- 99.99% SLA
- Advanced monitoring and logging""" ;
    vendor:providedBy vendor:AWSVendor .

