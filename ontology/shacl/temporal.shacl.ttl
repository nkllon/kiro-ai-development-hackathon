@prefix time: <http://nkllon.dev/time#> .
@prefix lifecycle: <http://nkllon.dev/lifecycle#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Temporal Entity Validation
time:TemporalEntityShape a sh:NodeShape ;
    sh:targetClass time:TemporalEntity ;
    sh:property [
        sh:path time:validFrom ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message "Temporal entity must have validFrom date"
    ] ;
    sh:sparql [
        sh:message "validUntil must be after validFrom" ;
        sh:select """
            SELECT $this WHERE {
                $this time:validFrom ?from .
                $this time:validUntil ?until .
                FILTER (?until <= ?from)
            }
        """
    ] .

# Temporal Chain Validation
time:TemporalChainShape a sh:NodeShape ;
    sh:targetClass time:TemporalEntity ;
    sh:sparql [
        sh:message "Supersession chain must be temporally consistent" ;
        sh:select """
            SELECT $this WHERE {
                $this time:supersedes ?prev .
                $this time:validFrom ?thisStart .
                ?prev time:validUntil ?prevEnd .
                FILTER (?thisStart < ?prevEnd)
            }
        """
    ] .

# Lifecycle State Validation
lifecycle:LifecycleEntityShape a sh:NodeShape ;
    sh:targetSubjectsOf lifecycle:hasState ;
    sh:property [
        sh:path lifecycle:hasState ;
        sh:in (lifecycle:draft lifecycle:active lifecycle:deprecated lifecycle:retired) ;
        sh:message "Lifecycle state must be one of: draft, active, deprecated, retired"
    ] ;
    sh:property [
        sh:path lifecycle:transitionedAt ;
        sh:datatype xsd:dateTime ;
        sh:message "Lifecycle transition must have timestamp"
    ] .