@prefix gov: <http://nkllon.dev/governance#> .
@prefix bm: <http://nkllon.dev/beastmaster#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Decision Record Validation
gov:DecisionShape a sh:NodeShape ;
    sh:targetClass gov:DecisionRecord ;
    sh:property [
        sh:path gov:outcome ;
        sh:in (gov:accepted gov:rejected gov:deferred gov:clarify) ;
        sh:minCount 1 ;
        sh:message "Decision must have valid outcome"
    ] ;
    sh:property [
        sh:path gov:about ;
        sh:minCount 1 ;
        sh:message "Decision must specify what it is about"
    ] ;
    sh:property [
        sh:path gov:decidedBy ;
        sh:class bm:Agent ;
        sh:minCount 1 ;
        sh:message "Decision must specify who decided"
    ] ;
    sh:property [
        sh:path gov:reason ;
        sh:datatype xsd:string ;
        sh:minLength 10 ;
        sh:minCount 1 ;
        sh:message "Decision must have documented reasoning (minimum 10 characters)"
    ] .

# Escape Patch Validation
gov:EscapePatchShape a sh:NodeShape ;
    sh:targetClass gov:EscapePatch ;
    sh:property [
        sh:path gov:invokedBy ;
        sh:class bm:Agent ;
        sh:minCount 1 ;
        sh:message "Escape patch must specify who invoked it"
    ] ;
    sh:property [
        sh:path gov:confidence ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:minCount 1 ;
        sh:message "Escape patch confidence must be between 0.0 and 1.0"
    ] ;
    sh:property [
        sh:path gov:recommendedAction ;
        sh:in (gov:accepted gov:rejected gov:deferred gov:clarify) ;
        sh:minCount 1 ;
        sh:message "Escape patch must recommend an action"
    ] .

# Behavior SLO Validation
gov:BehaviorSLOShape a sh:NodeShape ;
    sh:targetClass gov:BehaviorSLO ;
    sh:property [
        sh:path gov:targetsActor ;
        sh:class bm:Agent ;
        sh:minCount 1 ;
        sh:message "Behavior SLO must target at least one agent"
    ] ;
    sh:property [
        sh:path gov:targetsAffordanceSLO ;
        sh:class bm:Affordance ;
        sh:minCount 1 ;
        sh:message "Behavior SLO must target at least one affordance"
    ] ;
    sh:property [
        sh:path gov:targetRate ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.1 ;
        sh:maxInclusive 0.95 ;
        sh:message "Target rate should be between 10% and 95% (realistic targets)"
    ] ;
    sh:sparql [
        sh:message "BehaviorSLO should target agents that can actually use the affordance" ;
        sh:select """
            SELECT $this WHERE {
                $this gov:targetsActor ?agent .
                $this gov:targetsAffordanceSLO ?affordance .
                FILTER NOT EXISTS {
                    ?affordance bm:forAgent ?agent .
                }
            }
        """
    ] .

# Nudge Validation
gov:NudgeShape a sh:NodeShape ;
    sh:targetClass gov:Nudge ;
    sh:property [
        sh:path gov:nudgeType ;
        sh:in ("default" "reminder" "socialProof" "successToast" "blockerWithFix") ;
        sh:message "Nudge type must be: default, reminder, socialProof, successToast, or blockerWithFix"
    ] ;
    sh:property [
        sh:path gov:targetsAffordance ;
        sh:class bm:Affordance ;
        sh:minCount 1 ;
        sh:message "Nudge must target at least one affordance"
    ] .

# Ease of Action Validation
gov:EaseOfActionShape a sh:NodeShape ;
    sh:targetClass gov:EaseOfAction ;
    sh:property [
        sh:path gov:easeScore ;
        sh:datatype xsd:double ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Ease score must be between 0.0 (hard) and 1.0 (easy)"
    ] ;
    sh:property [
        sh:path gov:measuresAffordance ;
        sh:class bm:Affordance ;
        sh:minCount 1 ;
        sh:message "EaseOfAction must measure at least one affordance"
    ] .