@prefix sec: <http://nkllon.dev/security#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Security Classification Classes
sec:SecurityClassification a rdfs:Class ;
    rdfs:comment "A security classification level" .

sec:public a sec:SecurityClassification ;
    rdfs:comment "Public information, no access restrictions" .

sec:internal a sec:SecurityClassification ;
    rdfs:comment "Internal information, restricted to organization" .

sec:confidential a sec:SecurityClassification ;
    rdfs:comment "Confidential information, restricted access" .

sec:restricted a sec:SecurityClassification ;
    rdfs:comment "Restricted information, highly controlled access" .

# Access Control Classes
sec:Permission a rdfs:Class ;
    rdfs:comment "A permission to perform an action" .

sec:Role a rdfs:Class ;
    rdfs:comment "A role that grants permissions" .

sec:SecuredResource a rdfs:Class ;
    rdfs:comment "A resource with security classification" .

# Security Properties
sec:hasClassification a rdf:Property ;
    rdfs:range sec:SecurityClassification ;
    rdfs:comment "Security classification of resource" .

sec:accessRequires a rdf:Property ;
    rdfs:range sec:Permission ;
    rdfs:comment "Access requires specific permission" .

sec:authorizedBy a rdf:Property ;
    rdfs:comment "Access authorized by specific authority" .

sec:hasRole a rdf:Property ;
    rdfs:range sec:Role ;
    rdfs:comment "Agent has specific role" .

sec:grantsPermission a rdf:Property ;
    rdfs:domain sec:Role ;
    rdfs:range sec:Permission ;
    rdfs:comment "Role grants specific permission" .

# Security Validation Classes
sec:SecurityValidator a rdfs:Class ;
    rdfs:comment "Validates security compliance" .

sec:AccessControlList a rdfs:Class ;
    rdfs:comment "List of access control entries" .

sec:AccessControlEntry a rdfs:Class ;
    rdfs:comment "Single access control entry" .