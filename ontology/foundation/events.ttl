@prefix event: <http://nkllon.dev/event#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Event Sourcing Classes
event:DomainEvent a rdfs:Class ;
    rdfs:comment "A domain event that occurred in the system" .

event:DecisionMade a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating a decision was made" .

event:RequirementChanged a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating a requirement was changed" .

event:PolicyViolated a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating a policy was violated" .

event:EscapePatchTriggered a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating an escape patch was triggered" .

event:AlignmentCalculated a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating alignment was calculated" .

event:ConflictDetected a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating a conflict was detected" .

event:ThresholdViolated a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating a threshold was violated" .

event:SporeProposed a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating a spore was proposed" .

event:SporeAccepted a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating a spore was accepted" .

event:SporeRejected a rdfs:Class ; 
    rdfs:subClassOf event:DomainEvent ;
    rdfs:comment "Event indicating a spore was rejected" .

# Event Properties
event:eventId a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Unique identifier for the event" .

event:occurredAt a rdf:Property ; 
    rdfs:range xsd:dateTime ;
    rdfs:comment "When the event occurred" .

event:causedBy a rdf:Property ;
    rdfs:comment "What caused this event" .

event:affectedResource a rdf:Property ;
    rdfs:comment "Resource affected by this event" .

event:eventData a rdf:Property ;
    rdfs:comment "Additional data associated with the event" .

event:correlatesWithDecision a rdf:Property ;
    rdfs:comment "Event correlates with a decision" .

# Audit Trail Classes
event:AuditEntry a rdfs:Class ;
    rdfs:comment "An entry in an audit trail" .

event:AuditableResource a rdfs:Class ;
    rdfs:comment "A resource that can be audited" .

# Audit Properties
event:auditTrail a rdf:Property ;
    rdfs:range event:AuditEntry ;
    rdfs:comment "Audit trail for resource" .

event:hasEvent a rdf:Property ;
    rdfs:domain event:AuditEntry ;
    rdfs:range event:DomainEvent ;
    rdfs:comment "Audit entry has associated event" .