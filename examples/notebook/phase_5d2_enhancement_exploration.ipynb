   "source": [
    "# Use Case 3: Quality Validation\n",
    "try:\n",
    "    from src.phase_5d2_enhancement.analysis.quality_validator import QualityValidator\n",
    "    from src.phase_5d2_enhancement.analysis.dimension_analyzer import DimensionScores\n",
    "    \n",
    "    print(\"✅ Quality Validation Demo\")\n",
    "    print(\"=\" * 50)\n",
    "    \n",
    "    # Initialize validator\n",
    "    validator = QualityValidator()\n",
    "    \n",
    "    print(f\"🎯 Quality Target: {validator.quality_thresholds['overall_quality_target']}\")\n",
    "    print(f\"⚠️ Critical Gap Threshold: {validator.quality_thresholds['critical_gap_threshold']}%\")\n",
    "    \n",
    "    # Create sample dimension scores for demonstration\n",
    "    sample_scores = {\n",
    "        \"problem_taxonomy\": 59.5,\n",
    "        \"cost_optimization\": 60.6,\n",
    "        \"scalability_requirements\": 61.8,\n",
    "        \"innovation_potential\": 41.8,\n",
    "        \"testing_strategy\": 45.8,\n",
    "        \"compliance_regulations\": 47.5,\n",
    "        \"infrastructure_architecture\": 93.4,\n",
    "        \"maintainability\": 97.0\n",
    "    }\n",
    "    \n",
    "    overall_score = sum(sample_scores.values()) / len(sample_scores)\n",
    "    critical_gaps = [dim for dim, score in sample_scores.items() if score < 50.0]\n",
    "    \n",
    "    dimension_scores = DimensionScores(\n",
    "        spec_path=\"demo_system\",\n",
    "        scores=sample_scores,\n",
    "        overall_score=overall_score,\n",
    "        critical_gaps=critical_gaps\n",
    "    )\n",
    "    \n",
    "    print(f\"\\n📊 Sample Scores for Validation:\")\n",
    "    print(f\"  Overall Score: {overall_score:.1f}\")\n",
    "    print(f\"  Critical Gaps: {len(critical_gaps)} dimensions ({len(critical_gaps)/len(sample_scores)*100:.1f}%)\")\n",
    "    \n",
    "    # Validate quality targets\n",
    "    validation_results = validator.validate_quality_targets(dimension_scores)\n",
    "    \n",
    "    print(f\"\\n🔍 Validation Results:\")\n",
    "    passed = sum(1 for v in validation_results if v.passed)\n",
    "    total = len(validation_results)\n",
    "    print(f\"  Passed: {passed}/{total} validations\")\n",
    "    \n",
    "    for validation in validation_results[:5]:  # Show first 5 results\n",
    "        status = \"✅\" if validation.passed else \"❌\"\n",
    "        print(f\"  {status} {validation.validation_name}: {validation.message}\")\n",
    "    \n",
    "    # Assess Phase 5D2 completion\n",
    "    completion_status = validator.assess_phase_5d2_completion(dimension_scores)\n",
    "    \n",
    "    print(f\"\\n🎯 Phase 5D2 Completion Assessment:\")\n",
    "    print(f\"  Completion Criteria Met: {'✅ Yes' if completion_status.completion_criteria_met else '❌ No'}\")\n",
    "    print(f\"  Phase 5D3 Ready: {'✅ Yes' if completion_status.phase_5d3_ready else '❌ No'}\")\n",
    "    print(f\"  Blocking Issues: {len(completion_status.blocking_issues)}\")\n",
    "    \n",
    "    print(f\"\\n✅ Quality validation completed!\")\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"❌ Quality validation error: {e}\")"
   ]
