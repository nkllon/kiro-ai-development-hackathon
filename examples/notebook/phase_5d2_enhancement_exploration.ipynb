    "    if not critical_gap_target_met:\n",
    "        excess = critical_gap_percentage - critical_gap_threshold\n",
    "        print(f\"  🎯 Critical gap excess: {excess:.1f}%\")\n",
    "\n",
    "print(f\"\\n✅ Real-world simulation completed!\")"
