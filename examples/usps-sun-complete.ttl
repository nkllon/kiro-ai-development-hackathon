@prefix ex: <http://example.org/> .
@prefix bm: <http://nkllon.dev/beastmaster#> .
@prefix gov: <http://nkllon.dev/governance#> .
@prefix spore: <http://nkllon.dev/spore#> .
@prefix align: <http://nkllon.dev/alignment#> .
@prefix time: <http://nkllon.dev/time#> .
@prefix lifecycle: <http://nkllon.dev/lifecycle#> .
@prefix sec: <http://nkllon.dev/security#> .
@prefix event: <http://nkllon.dev/event#> .
@prefix bridge: <http://nkllon.dev/bridge#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Agents
ex:SunSales a bm:HumanAgent ;
    rdfs:label "Sun Microsystems Sales Team" ;
    sec:hasRole ex:SalesRole .

ex:USPS_IT a bm:HumanAgent ;
    rdfs:label "USPS IT Department" ;
    sec:hasRole ex:ITRole .

ex:Joe a bm:HumanAgent ;
    rdfs:label "Joe (USPS Developer)" ;
    sec:hasRole ex:DeveloperRole .

# Security Roles
ex:SalesRole a sec:Role ;
    sec:grantsPermission ex:ViewRevenueData .

ex:ITRole a sec:Role ;
    sec:grantsPermission ex:ViewUtilizationData ;
    sec:grantsPermission ex:MakeArchitecturalDecisions .

ex:DeveloperRole a sec:Role ;
    sec:grantsPermission ex:ViewInternalData .

# Temporal requirement evolution
ex:R_MaximizeProfit a bm:Requirement ;
    rdfs:label "Maximize hardware revenue" ;
    bm:hasValidationCriteria ex:VC_RevenueIncrease ;
    time:validFrom "2024-01-01T00:00:00Z"^^xsd:dateTime ;
    lifecycle:hasState lifecycle:active ;
    sec:hasClassification sec:internal .

ex:VC_RevenueIncrease a bm:ValidationCriteria ;
    rdfs:comment "Revenue must increase by at least 10%" .

ex:R_MaximizeUtilization_v1 a bm:Requirement ;
    rdfs:label "Achieve >=50% sustained utilization per system" ;
    bm:hasValidationCriteria ex:VC_UtilizationTarget_v1 ;
    time:validFrom "2024-01-01T00:00:00Z"^^xsd:dateTime ;
    time:validUntil "2024-12-31T23:59:59Z"^^xsd:dateTime ;
    lifecycle:hasState lifecycle:deprecated ;
    lifecycle:transitionedAt "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    lifecycle:transitionReason "Increased utilization target based on efficiency improvements" ;
    sec:hasClassification sec:internal .

ex:VC_UtilizationTarget_v1 a bm:ValidationCriteria ;
    rdfs:comment "Utilization must be >= 50%" .

ex:R_MaximizeUtilization_v2 a bm:Requirement ;
    rdfs:label "Achieve >=60% sustained utilization per system" ;
    bm:hasValidationCriteria ex:VC_UtilizationTarget_v2 ;
    time:validFrom "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    time:supersedes ex:R_MaximizeUtilization_v1 ;
    lifecycle:hasState lifecycle:active ;
    sec:hasClassification sec:internal .

ex:VC_UtilizationTarget_v2 a bm:ValidationCriteria ;
    rdfs:comment "Utilization must be >= 60%" .

# Specifications with acceptance criteria
ex:OneOraclePerBox a bm:Specification ;
    rdfs:label "One Oracle Instance Per Physical Server" ;
    bm:hasAcceptanceCriteria ex:AC_Runs ;
    sec:hasClassification sec:internal .

ex:AC_Runs a bm:AcceptanceCriteria ;
    rdfs:comment "System runs Oracle successfully on dedicated hardware" .

ex:ConsolidatedDomains a bm:Specification ;
    rdfs:label "Consolidated Oracle Domains on Shared Hardware" ;
    bm:hasAcceptanceCriteria ex:AC_Utilization ;
    sec:hasClassification sec:internal .

ex:AC_Utilization a bm:AcceptanceCriteria ;
    rdfs:comment "Achieves target utilization levels through consolidation" .

# Artifacts that trace to requirements
ex:ConsolidationPlan a bm:Artifact ;
    rdfs:label "Oracle Consolidation Implementation Plan" ;
    bm:tracesTo ex:R_MaximizeUtilization_v2 ;
    sec:hasClassification sec:confidential .

ex:RevenueProjection a bm:Artifact ;
    rdfs:label "Hardware Revenue Projection Model" ;
    bm:tracesTo ex:R_MaximizeProfit ;
    sec:hasClassification sec:confidential .

# Spores with evidence
ex:Spore_SunApproach a spore:Spore ;
    rdfs:label "Sun's One-Oracle-Per-Box Approach" ;
    spore:proposes ex:OneOraclePerBox ;
    spore:hasEvidence ex:Evidence_Revenue ;
    sec:hasClassification sec:internal .

ex:Evidence_Revenue a spore:Evidence ;
    rdfs:comment "Projected hardware revenue increase of $1M annually" ;
    metr:value 1000000.0 ;
    metr:unit "USD" .

ex:Spore_Consolidation a spore:Spore ;
    rdfs:label "USPS Consolidation Approach" ;
    spore:proposes ex:ConsolidatedDomains ;
    spore:hasEvidence ex:Evidence_Utilization ;
    spore:hasEvidence ex:Evidence_SpaceSavings ;
    sec:hasClassification sec:internal .

ex:Evidence_Utilization a spore:Evidence ;
    rdfs:comment "Projected utilization with consolidation" ;
    metr:value 75.0 ;
    metr:unit "percent" .

ex:Evidence_SpaceSavings a spore:Evidence ;
    rdfs:comment "Data center space reduction" ;
    metr:value 60.0 ;
    metr:unit "percent" .

# Alignment calculations
ex:USPS_ObjectiveSpace a align:ObjectiveSpace ;
    rdfs:label "USPS Decision Objective Space" ;
    align:hasDimension ex:UtilizationDim ;
    align:hasDimension ex:SpaceDim ;
    align:hasDimension ex:RevenueDim .

ex:UtilizationDim a align:UtilizationDimension ;
    rdfs:label "System Utilization" ;
    align:unit "percentage" .

ex:SpaceDim a align:SpaceDimension ;
    rdfs:label "Data Center Floor Space" ;
    align:unit "square_feet" .

ex:RevenueDim a align:RevenueDimension ;
    rdfs:label "Hardware Revenue" ;
    align:unit "USD" .

# Requirement vectors
ex:R_MaximizeUtilization_v2 
    align:hasObjectiveSpace ex:USPS_ObjectiveSpace ;
    align:hasVector ex:Vector_USPS ;
    align:hasWeight 0.7 .

ex:Vector_USPS a align:RequirementVector ;
    rdfs:comment "Normalized vector [+1, -1, 0] = [0.7071, -0.7071, 0]" ;
    align:dimensionValue [
        align:dimension ex:UtilizationDim ;
        align:value 0.7071
    ] ;
    align:dimensionValue [
        align:dimension ex:SpaceDim ;
        align:value -0.7071
    ] ;
    align:dimensionValue [
        align:dimension ex:RevenueDim ;
        align:value 0.0
    ] .

ex:R_MaximizeProfit 
    align:hasObjectiveSpace ex:USPS_ObjectiveSpace ;
    align:hasVector ex:Vector_Sun ;
    align:hasWeight 0.3 .

ex:Vector_Sun a align:RequirementVector ;
    rdfs:comment "Normalized vector [0, 0, +1] = [0, 0, 1]" ;
    align:dimensionValue [
        align:dimension ex:UtilizationDim ;
        align:value 0.0
    ] ;
    align:dimensionValue [
        align:dimension ex:SpaceDim ;
        align:value 0.0
    ] ;
    align:dimensionValue [
        align:dimension ex:RevenueDim ;
        align:value 1.0
    ] .

# Solution outcomes
ex:Consolidation_Outcome a align:SolutionOutcome ;
    rdfs:label "Consolidation Solution Outcome" ;
    align:inObjectiveSpace ex:USPS_ObjectiveSpace ;
    align:dimensionValue [
        align:dimension ex:UtilizationDim ;
        align:value 0.8
    ] ;
    align:dimensionValue [
        align:dimension ex:SpaceDim ;
        align:value -0.6
    ] ;
    align:dimensionValue [
        align:dimension ex:RevenueDim ;
        align:value -0.2
    ] .

# Feasibility constraints
ex:MinUtilizationConstraint a align:FeasibilityConstraint ;
    align:constrainsDimension ex:UtilizationDim ;
    align:lowerBound 0.6 ;
    rdfs:comment "Utilization must be >= 60%" .

# Alignment calculations
ex:Alignment_USPS_Consolidation a align:AlignmentCalculation ;
    align:requirement ex:R_MaximizeUtilization_v2 ;
    align:outcome ex:Consolidation_Outcome ;
    align:alignmentScore 0.85 .

ex:Alignment_Sun_Consolidation a align:AlignmentCalculation ;
    align:requirement ex:R_MaximizeProfit ;
    align:outcome ex:Consolidation_Outcome ;
    align:alignmentScore -0.2 .

# Conflict measure
ex:Conflict_USPS_Sun a align:ConflictMeasure ;
    align:requirement1 ex:R_MaximizeUtilization_v2 ;
    align:requirement2 ex:R_MaximizeProfit ;
    align:conflictScore 0.5 .

# Global alignment score
ex:GlobalAlignment_Consolidation a align:GlobalAlignmentScore ;
    align:outcome ex:Consolidation_Outcome ;
    align:weightedScore 0.655 .

# Governance decisions with complete audit trail
ex:Check_Conflict a gov:AlignmentCheck ;
    rdfs:label "Conflict Analysis Between USPS and Sun Requirements" ;
    gov:checksAlignmentWith ex:Conflict_USPS_Sun ;
    gov:alignmentResult "conflicted" ;
    gov:threshold 0.5 .

ex:Decision_Sun a gov:DecisionRecord ;
    rdfs:label "Decision on Sun's One-Oracle-Per-Box Approach" ;
    gov:about ex:Spore_SunApproach ;
    gov:outcome gov:rejected ;
    gov:reason "Violates utilization objective; space/power constraints make this approach infeasible for USPS data center requirements" ;
    gov:decidedBy ex:USPS_IT ;
    gov:basedOn ex:Check_Conflict ;
    sec:hasClassification sec:internal .

ex:Decision_Consolidate_v2 a gov:DecisionRecord ;
    rdfs:label "Decision on Consolidation Approach (v2)" ;
    gov:about ex:Spore_Consolidation ;
    gov:outcome gov:accepted ;
    gov:reason "Updated alignment calculation shows 0.655 score with new v2 requirements; meets utilization >=60%, reduces footprint significantly" ;
    gov:decidedBy ex:USPS_IT ;
    gov:basedOn ex:ComputationalAlignmentCheck ;
    event:auditTrail ex:AuditTrail_Consolidation ;
    sec:hasClassification sec:internal ;
    time:validFrom "2025-01-02T10:30:00Z"^^xsd:dateTime .

ex:ComputationalAlignmentCheck a gov:AlignmentCheck ;
    rdfs:label "Mathematical Alignment Validation" ;
    gov:checksAlignmentWith ex:GlobalAlignment_Consolidation ;
    gov:alignmentResult "aligned" ;
    gov:threshold 0.5 .

# Personal ontology with security
ex:JoeLexicon a bm:PersonalOntology ;
    rdfs:label "Joe's Personal Technical Vocabulary" ;
    bm:maintainedBy ex:Joe ;
    bm:definesAliasFor ex:ConsolidationPlan ;
    sec:hasClassification sec:confidential ;
    sec:accessRequires ex:ViewInternalData ;
    time:validFrom "2024-06-01T00:00:00Z"^^xsd:dateTime ;
    bm:hasAliasEntry ex:JoeAlias_Dingdong ;
    bm:hasAliasEntry ex:JoeAlias_StinkyFlank .

ex:JoeAlias_Dingdong a bm:AliasEntry ;
    bm:aliasFor ex:ConsolidationPlan ;
    bm:personalTerm "dingdong" ;
    bm:confidence 0.9 ;
    bm:contextualUsage "When frustrated with consolidation complexity" .

ex:JoeAlias_StinkyFlank a bm:AliasEntry ;
    bm:aliasFor ex:ConsolidationPlan ;
    bm:personalTerm "left-handed stinky-flank" ;
    bm:confidence 0.95 ;
    bm:contextualUsage "During team meetings when discussing technical debt" .

# Bridge policies
ex:InternalBridge a bridge:BabelBridge ;
    rdfs:label "Internal Team Communication Bridge" ;
    bridge:fromVocabulary ex:JoeLexicon ;
    bridge:toVocabulary ex:InternalVocabulary ;
    bridge:method "mapping" ;
    bridge:confidence 0.8 ;
    bridge:mapsTerm ex:ConsolidationPlan .

ex:ExternalBridge a bridge:BabelBridge ;
    rdfs:label "External Partner Communication Bridge" ;
    bridge:fromVocabulary ex:InternalVocabulary ;
    bridge:toVocabulary ex:PartnerAPI ;
    bridge:method "rule-based" ;
    bridge:confidence 0.95 ;
    bridge:mapsTerm ex:ConsolidationPlan .

ex:RelaxedPolicy a bridge:VocabularyPolicy ;
    rdfs:label "Internal Communication Policy" ;
    bridge:appliesToBridge ex:InternalBridge ;
    bridge:allowPersonalOntology true ;
    bridge:requiresCanonicalLabels false .

ex:NoSlangPolicy a bridge:VocabularyPolicy ;
    rdfs:label "External Communication Policy" ;
    bridge:appliesToBridge ex:ExternalBridge ;
    bridge:allowPersonalOntology false ;
    bridge:requiresCanonicalLabels true .

# Behavioral governance
ex:SLO_CanonicalTermUsage a gov:BehaviorSLO ;
    rdfs:label "Canonical Term Usage SLO" ;
    gov:targetsActor ex:Joe ;
    gov:targetsAffordanceSLO ex:Affordance_APDocumentation ;
    gov:targetRate 0.8 .

ex:Affordance_APDocumentation a bm:Affordance ;
    rdfs:label "Documentation Interface" ;
    bm:forAgent ex:Joe ;
    bm:fulfills ex:Policy_ProfessionalCommunication ;
    ui:supportsModality ui:Text .

ex:Nudge_CanonicalTerms a gov:Nudge ;
    rdfs:label "Canonical Term Reminder" ;
    gov:nudgeType "blockerWithFix" ;
    gov:targetsAffordance ex:Affordance_ExternalAPI ;
    gov:message "Personal term detected. Suggest: 'Oracle Consolidation Plan'" .

# Complete audit trail
ex:AuditTrail_Consolidation a event:AuditEntry ;
    rdfs:label "Complete Audit Trail for Consolidation Decision" ;
    event:hasEvent ex:Event_RequirementChanged ;
    event:hasEvent ex:Event_AlignmentRecalculated ;
    event:hasEvent ex:Event_DecisionMade .

ex:Event_RequirementChanged a event:RequirementChanged ;
    event:eventId "req_change_001" ;
    event:occurredAt "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    event:causedBy ex:USPS_IT ;
    event:affectedResource ex:R_MaximizeUtilization_v1 ;
    event:eventData "Utilization target increased from 50% to 60% based on efficiency analysis" .

ex:Event_AlignmentRecalculated a event:AlignmentCalculated ;
    event:eventId "align_calc_002" ;
    event:occurredAt "2025-01-02T09:15:00Z"^^xsd:dateTime ;
    event:causedBy ex:AlignmentEngine ;
    event:affectedResource ex:Spore_Consolidation ;
    event:eventData "New alignment score: 0.655 (was 0.595 with v1 requirements)" .

ex:Event_DecisionMade a event:DecisionMade ;
    event:eventId "decision_003" ;
    event:occurredAt "2025-01-02T10:30:00Z"^^xsd:dateTime ;
    event:causedBy ex:USPS_IT ;
    event:affectedResource ex:Decision_Consolidate_v2 ;
    event:eventData "Decision accepted based on improved alignment with updated requirements" .

# System components
ex:AlignmentEngine a bm:LLMAgent ;
    rdfs:label "Mathematical Alignment Calculation Engine" ;
    sec:hasRole ex:CalculationRole .

ex:InternalVocabulary a rdfs:Resource ;
    rdfs:label "USPS Internal Technical Vocabulary" .

ex:PartnerAPI a rdfs:Resource ;
    rdfs:label "External Partner API Vocabulary" .

ex:Policy_ProfessionalCommunication a bm:Policy ;
    rdfs:label "Professional Communication Standards" ;
    bm:requiresConcern ex:VocabularyConsistency .

ex:VocabularyConsistency a bm:CrosscuttingConcern ;
    rdfs:label "Vocabulary Consistency Across Communications" .